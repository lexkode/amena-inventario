# Base de datos PostgreSQL (Supabase). Usa el connection string del pooler
# (modo Transaction, puerto 6543) para entornos serverless como Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Secreto de sesión (rotar en producción)
SESSION_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Cloudflare R2 (almacenamiento de imágenes del plano y lotes)
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET=inventory-app-uploads
R2_PUBLIC_BASE_URL=https://assets.tu-dominio.com

# Credenciales iniciales del seed (solo para ejecutar `pnpm db:seed`)
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambiar_por_una_password_fuerte
