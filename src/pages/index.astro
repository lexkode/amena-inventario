---
import PublicLayout from "@shared/layouts/PublicLayout.astro";
import { getPlanoActivo } from "@features/plan/plano.service";
import { getLotesPublicados } from "@features/lots/lote.service";
import { getPuntosPublicados } from "@features/points/punto.service";
import { getModelos } from "@features/catalog/modelo.service";
import { getMarca } from "@features/branding/marca.service";
import mapBg from "@assets/logo-bg-transparency.webp";
import logo from "@assets/logo-AMENA.webp";

const plan = await getPlanoActivo();
const publicados = await getLotesPublicados();
const lotes = publicados ?? [];
const puntos = (await getPuntosPublicados()) ?? [];
const modelos = await getModelos();
const marca = await getMarca();
const logoFront = marca.logoFrontPath ?? logo.src;

const counts = {
  all: lotes.length,
  disponible: lotes.filter((l) => l.estado === "disponible").length,
  reservado: lotes.filter((l) => l.estado === "reservado").length,
  vendido: lotes.filter((l) => l.estado === "vendido").length,
};

const initialData = { plan, lotes, puntos, modelos, counts };

const planCornerRadius = plan
  ? Math.round(Math.min(plan.anchoPx, plan.altoPx) * 0.015)
  : 0;
---

<PublicLayout title="Residencial Amena · Lotes disponibles en Comalapa" brand={marca}>
  <section class="map-section">
    <div class="logo-float">
      <img src={logoFront} alt="Residencial Amena" />
    </div>
    <div class="container">
      {
        !plan ? (
          <div class="empty card-empty">
            <h3>Próximamente</h3>
            <p>
              Estamos preparando el plano del residencial. Vuelve pronto para
              descubrir los lotes disponibles.
            </p>
          </div>
        ) : (
          <>
            <div
              class="canvas-wrap"
              style={`aspect-ratio: ${plan.anchoPx}/${plan.altoPx}`}
            >
              <svg
                id="canvas"
                viewBox={`0 0 ${plan.anchoPx} ${plan.altoPx}`}
                preserveAspectRatio="xMidYMid meet"
              >
                {planCornerRadius > 0 && (
                  <defs>
                    <clipPath id="plan-clip">
                      <rect
                        x="0"
                        y="0"
                        width={plan.anchoPx}
                        height={plan.altoPx}
                        rx={planCornerRadius}
                        ry={planCornerRadius}
                      />
                    </clipPath>
                  </defs>
                )}
                <image
                  id="plan-image"
                  href={plan.imagenPath}
                  x="0"
                  y="0"
                  width={plan.anchoPx}
                  height={plan.altoPx}
                  preserveAspectRatio="xMidYMid meet"
                  clip-path={planCornerRadius > 0 ? "url(#plan-clip)" : undefined}
                />
                <g id="lots-layer" />
                <g id="puntos-layer" />
              </svg>
              <div class="filter-bar">
                <div class="filter-group">
                  <span class="filter-label">Estado</span>
                  <div
                    class="pills"
                    role="tablist"
                    aria-label="Filtrar por estado"
                  >
                    <button data-status="all" class="pill active" type="button">
                      Todos <span class="pill-count">{counts.all}</span>
                    </button>
                    <button
                      data-status="disponible"
                      class="pill pill-disponible"
                      type="button"
                    >
                      Disponibles <span class="pill-count">{counts.disponible}</span>
                    </button>
                    <button
                      data-status="reservado"
                      class="pill pill-reservado"
                      type="button"
                    >
                      Reservados <span class="pill-count">{counts.reservado}</span>
                    </button>
                    <button
                      data-status="vendido"
                      class="pill pill-vendido"
                      type="button"
                    >
                      Vendidos <span class="pill-count">{counts.vendido}</span>
                    </button>
                  </div>
                </div>
                <div class="filter-group">
                  <label for="modelo-filter" class="filter-label">
                    Modelo de casa
                  </label>
                  <select id="modelo-filter" class="select">
                    <option value="">Todos los modelos</option>
                  </select>
                </div>
              </div>
              <div
                class="zoom-controls"
                role="group"
                aria-label="Controles de zoom"
              >
                <button
                  id="zoom-out"
                  class="zoom-btn"
                  type="button"
                  aria-label="Reducir"
                >
                  −
                </button>
                <span id="zoom-display" class="zoom-display">
                  100%
                </span>
                <button
                  id="zoom-in"
                  class="zoom-btn"
                  type="button"
                  aria-label="Aumentar"
                >
                  +
                </button>
                <button id="zoom-fit" class="zoom-btn zoom-fit" type="button">
                  Fit
                </button>
              </div>
            </div>

            <div
              class="modal-backdrop"
              id="lot-modal-backdrop"
              aria-hidden="true"
            >
              <div
                class="modal"
                id="lot-modal"
                role="dialog"
                aria-modal="true"
                aria-labelledby="lot-modal-title"
              >
                <button
                  class="modal-close"
                  id="lot-modal-close"
                  type="button"
                  aria-label="Cerrar"
                >
                  ×
                </button>
                <div class="modal-grid">
                  <div class="modal-gallery" id="lot-modal-gallery" />
                  <div class="modal-info" id="lot-modal-info" />
                </div>
              </div>
            </div>

            <div
              class="modal-backdrop"
              id="punto-modal-backdrop"
              aria-hidden="true"
            >
              <div
                class="modal"
                id="punto-modal"
                role="dialog"
                aria-modal="true"
                aria-labelledby="punto-modal-title"
              >
                <button
                  class="modal-close"
                  id="punto-modal-close"
                  type="button"
                  aria-label="Cerrar"
                >
                  ×
                </button>
                <div class="modal-grid">
                  <div class="modal-gallery" id="punto-modal-gallery" />
                  <div class="modal-info" id="punto-modal-info" />
                </div>
              </div>
            </div>

            <div
              class="modal-backdrop contact-backdrop"
              id="contact-modal-backdrop"
              aria-hidden="true"
            >
              <div
                class="modal contact-modal"
                id="contact-modal"
                role="dialog"
                aria-modal="true"
              >
                <button
                  class="modal-close"
                  id="contact-modal-close"
                  type="button"
                  aria-label="Cerrar"
                >
                  ×
                </button>
                <div class="contact-header" id="contact-header" />
                <div class="contact-body">
                  <div
                    id="client-form-embed-placeholder"
                    class="form-embed-placeholder"
                  >
                    <p class="form-embed-text">[ Formulario de contacto ]</p>
                  </div>
                </div>
              </div>
            </div>
          </>
        )
      }
    </div>
  </section>

  <style define:vars={{ mapBgSrc: `url("${mapBg.src}")` }}>
    /* ===== Buttons ===== */
    button {
      background: transparent;
      transition: background-color 300ms ease 0ms;
      border-radius: 6px;
    }
    /* ===== Section ===== */
    .logo-float {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 10;
      padding: 1rem;
      max-width: 200px;
      background-color: var(--c-float-bg);
      border-width: 0px;
      border-color: var(--c-float-border);
      border-radius: 1rem;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .logo-float img {
      display: block;
      width: 100%;
      height: auto;
    }
    .map-section {
      height: 100vh;
      position: relative;
      background-color: var(--c-bg);
      background-image: var(--mapBgSrc);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }
    .map-section > .container {
      padding: 0;
      height: 100%;
      max-width: none;
    }

    .empty {
      background: var(--c-white);
      border: 1px solid var(--c-line);
      border-radius: 14px;
      padding: 3rem 1.5rem;
      text-align: center;
    }
    .empty h3 {
      margin: 0 0 0.5rem;
      font-size: 1.3rem;
    }
    .empty p {
      margin: 0;
      color: var(--c-text);
      max-width: 480px;
      margin-inline: auto;
    }

    /* ===== Filter bar ===== */
    .filter-bar {
      position: absolute;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      width: 90%;
      max-width: 800px;
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem 1.75rem;
      align-items: flex-end;
      justify-content: space-between;
      background: var(--c-white);
      border: 1px solid var(--c-line);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      box-shadow: var(--c-shadow-soft);
    }
    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .filter-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--c-text);
      font-weight: 600;
    }
    .pills {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .pill {
      border-width: 0px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      padding: 6px 12px;
      cursor: pointer;
      color: var(--c-text);
      background: var(--c-bg-light);
    }
    .pill-count {
      display: inline-block;
      margin-left: 0.4rem;
      min-width: 1.5rem;
      padding: 0.05rem 0.45rem;
      border-radius: 999px;
      background: rgba(36, 72, 88, 0.12);
      font-size: 0.72rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      text-align: center;
      line-height: 1.3;
    }
    .pill.active .pill-count {
      background: rgba(255, 255, 255, 0.22);
    }
    .pill[data-status="all"].active,
    .pill[data-status="all"]:hover {
      background: var(--c-bg-dark);
      color: var(--c-white);
    }
    .pill-disponible.active,
    .pill-disponible:hover {
      background: var(--c-disponible);
      color: var(--c-white);
    }
    .pill-reservado.active,
    .pill-reservado:hover {
      background: var(--c-reservado);
      color: var(--c-white);
    }
    .pill-vendido.active,
    .pill-vendido:hover {
      background: var(--c-vendido);
      color: var(--c-white);
    }

    .select {
      padding: 0.5rem 0.75rem;
      background: var(--c-white);
      color: var(--c-text);
      border: 1px solid var(--c-line);
      border-radius: 8px;
      font-size: 13px;
      min-width: 220px;
      cursor: pointer;
    }
    .select:focus {
      outline: 2px solid var(--c-focus);
      border-color: transparent;
    }

    /* ===== Canvas ===== */
    .canvas-wrap {
      position: relative;
      overflow: visible;
      width: 100%;
      height: 100%;
    }
    #canvas {
      display: block;
      width: 100%;
      height: 100%;
      cursor: grab;
      touch-action: none;
      overflow: visible;
      padding: 2rem 2rem 8rem;
    }
    #canvas:active {
      cursor: grabbing;
    }

    /* Polygons y labels se crean desde el script (sin data-astro-cid-*),
     por eso usamos :global() para que el scope no las oculte. */
    :global(.lote-polygon) {
      cursor: pointer;
      transition:
        filter 0.15s,
        opacity 0.15s;
    }
    :global(.lote-polygon.lote-disponible):hover {
      filter: drop-shadow(0 0 6px var(--c-disponible-glow));
    }
    :global(.lote-polygon.lote-reservado):hover {
      filter: drop-shadow(0 0 6px var(--c-reservado-glow));
    }
    :global(.lote-polygon.lote-vendido):hover {
      filter: drop-shadow(0 0 6px var(--c-vendido-glow));
    }
    :global(.lote-polygon.dimmed) {
      opacity: 0.4;
      pointer-events: none;
    }

    .zoom-controls {
      position: absolute;
      right: 1rem;
      top: 1rem;
      display: inline-flex;
      align-items: center;
      background: var(--c-bg-dark);
      border-radius: 10px;
      padding: 0.25rem;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .zoom-btn {
      border-width: 0px;
      border-radius: 6px;
      color: var(--c-white);
      font-size: 14px;
      font-weight: 600;
      padding: 6px;
      width: 2.25rem;
      height: 2.25rem;
      cursor: pointer;
    }
    .zoom-fit {
      width: auto;
      padding: 0 0.6rem;
      font-size: 0.8rem;
    }
    .zoom-display {
      color: var(--c-line);
      font-size: 0.78rem;
      padding: 0 0.4rem;
      min-width: 3.4rem;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    /* ===== Modals (centered) ===== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: var(--c-overlay-mid);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 5vh 5vw;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .modal-backdrop.open {
      display: flex;
      opacity: 1;
    }
    .modal {
      background: var(--c-white);
      border-radius: 16px;
      width: 90%;
      max-width: 1400px;
      max-height: 90vh;
      overflow: hidden;
      box-shadow: var(--c-shadow-strong);
      display: flex;
      flex-direction: column;
      position: relative;
      transform: translateY(8px) scale(0.98);
      opacity: 0;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }
    .modal-backdrop.open .modal {
      transform: none;
      opacity: 1;
    }
    .modal-close {
      position: absolute;
      top: 0.85rem;
      right: 0.85rem;
      z-index: 5;
      width: 2.25rem;
      height: 2.25rem;
      border: 0;
      border-radius: 999px;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
    }

    .modal-grid {
      display: grid;
      grid-template-columns: 1fr 400px;
      flex: 1;
      min-height: 0;
    }
    .modal-gallery {
      position: relative;
      background: var(--c-bg-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      min-height: 0;
    }
    :global(.gallery-svg) {
      width: 100%;
      height: 100%;
      display: block;
    }
    :global(.gallery-caption) {
      position: absolute;
      left: 1rem;
      top: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.9rem;
      background: var(--c-overlay-strong);
      color: var(--c-white);
      border-radius: 8px;
      font-size: 0.85rem;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      pointer-events: none;
    }
    :global(.gallery-caption-lote) {
      font-weight: 700;
    }
    :global(.gallery-caption-divider) {
      color: var(--c-line);
    }
    :global(.gallery-caption-modelo) {
      color: var(--c-line);
    }

    :global(.lot-gallery) {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    :global(.lot-gallery-viewer) {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    :global(.lot-gallery-img) {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      display: block;
    }
    :global(.lot-gallery-counter) {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      padding: 0.25rem 0.6rem;
      background: var(--c-overlay-strong);
      color: var(--c-white);
      border-radius: var(--r-pill);
      font-size: 0.75rem;
      font-variant-numeric: tabular-nums;
    }
    :global(.lot-gallery-nav) {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.4rem;
      height: 2.4rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--c-overlay-strong);
      color: var(--c-white);
      border: 0;
      border-radius: 50%;
      cursor: pointer;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    :global(.lot-gallery-nav:hover) {
      background: var(--c-accent);
    }
    :global(.lot-gallery-prev) {
      left: 0.75rem;
    }
    :global(.lot-gallery-next) {
      right: 0.75rem;
    }
    :global(.lot-gallery-thumbs) {
      display: flex;
      gap: 0.5rem;
      padding: 0.75rem;
      overflow-x: auto;
      background: rgba(0, 0, 0, 0.3);
      flex-shrink: 0;
    }
    :global(.lot-gallery-thumb) {
      width: 68px;
      height: 50px;
      flex-shrink: 0;
      padding: 0;
      border: 2px solid transparent;
      border-radius: 6px;
      overflow: hidden;
      cursor: pointer;
      background: transparent;
    }
    :global(.lot-gallery-thumb img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    :global(.lot-gallery-thumb.active) {
      border-color: var(--c-accent);
    }

    .modal-info {
      background: var(--c-white);
      border-left: 1px solid var(--c-line);
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    :global(.modal-info .info-header) {
      padding: 1.4rem 1.5rem 1.25rem;
      border-bottom: 1px solid var(--c-line);
    }
    :global(.modal-info .info-title-row) {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 0.4rem;
    }
    :global(.modal-info .info-title) {
      margin: 0;
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      line-height: 1.15;
    }
    :global(.modal-info .info-model-name) {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--c-text);
    }
    :global(.modal-info .info-model-name.muted) {
      color: var(--c-text-muted);
      font-size: 0.9rem;
      font-weight: 500;
    }
    :global(.modal-info .info-model-price) {
      margin: 0.15rem 0 0;
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--c-accent);
    }
    :global(.modal-info .status-badge) {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: capitalize;
    }
    :global(.modal-info .status-disponible) {
      background: var(--c-disponible-bg);
      color: var(--c-disponible-fg);
    }
    :global(.modal-info .status-reservado) {
      background: var(--c-reservado-bg);
      color: var(--c-reservado-fg);
    }
    :global(.modal-info .status-vendido) {
      background: var(--c-vendido-bg);
      color: var(--c-vendido-fg);
    }

    :global(.modal-info .info-body) {
      flex: 1;
      padding: 1.25rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      overflow-y: auto;
    }
    :global(.modal-info .lot-specs),
    :global(.modal-info .modelo-specs) {
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.25rem;
      padding: 1rem 1.1rem;
      background: var(--c-surface-muted);
      border: 1px solid var(--c-line);
      border-radius: 12px;
    }
    :global(.modal-info .spec) {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }
    :global(.modal-info .lot-specs dt),
    :global(.modal-info .modelo-specs dt) {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--c-text-muted);
      font-weight: 700;
    }
    :global(.modal-info .lot-specs dd),
    :global(.modal-info .modelo-specs dd) {
      margin: 0;
      font-size: 1rem;
      font-weight: 800;
      color: var(--c-text);
      overflow-wrap: anywhere;
    }
    :global(.modal-info .features-block) {
      padding: 1rem 1.1rem;
      background: var(--c-surface-muted);
      border: 1px solid var(--c-line);
      border-radius: 12px;
    }
    :global(.modal-info .features-eyebrow) {
      margin: 0;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--c-text-muted);
      font-weight: 700;
    }
    :global(.modal-info .features) {
      list-style: none;
      padding: 0;
      margin: 0.6rem 0 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    :global(.modal-info .features li) {
      padding-left: 1.3rem;
      position: relative;
      font-size: 0.9rem;
      color: var(--c-text);
    }
    :global(.modal-info .features li::before) {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--c-disponible);
      font-weight: 700;
    }
    :global(.punto-marker) {
      cursor: pointer;
    }
    :global(.modal-info .poi-info-text) {
      margin: 0;
      white-space: pre-line;
      color: var(--c-text);
      font-size: 0.95rem;
      line-height: 1.6;
    }
    :global(.poi-placeholder) {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      padding: 2rem;
      text-align: center;
      color: var(--c-white);
      font-size: 1.15rem;
      font-weight: 700;
    }
    :global(.modal-info .info-footer) {
      border-top: 1px solid var(--c-line);
      padding: 1rem 1.5rem 1.25rem;
      background: var(--c-white);
    }
    :global(.modal-info .info-cta) {
      color: var(--c-white);
      border: 0;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      background-color: var(--c-bg-dark);
      display: block;
      width: 100%;
      text-align: center;
      padding: 0.9rem 1rem;
      cursor: pointer;
      font-family: inherit;
    }
    :global(.modal-info .info-cta:hover) {
      background-color: var(--c-accent);
    }
    :global(.modal-info .info-cta-note) {
      margin: 0.5rem 0 0;
      text-align: center;
      font-size: 0.75rem;
      color: var(--c-text-muted);
    }

    /* ===== Contact Modal (sub-modal) ===== */
    .contact-backdrop {
      z-index: 110;
    }
    .contact-modal {
      max-width: 720px;
    }
    .contact-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--c-line);
    }
    :global(.contact-header-eyebrow) {
      margin: 0 0 0.25rem;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--c-text);
      font-weight: 600;
    }
    :global(.contact-header-title) {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 700;
    }
    :global(.contact-header-title strong) {
      color: var(--c-text);
    }
    :global(.contact-header-title-divider) {
      color: var(--c-line);
      margin: 0 0.4rem;
    }
    :global(.contact-header-title-modelo) {
      color: var(--c-text);
      font-weight: 600;
    }
    .contact-body {
      padding: 1.5rem;
    }
    .form-embed-placeholder {
      padding: 1.5rem;
      background: var(--c-white);
      border: 1px dashed var(--c-line);
      border-radius: 8px;
      text-align: center;
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .form-embed-text {
      font-size: 0.875rem;
      color: var(--c-text);
      margin: 0;
    }

    /* ===== Responsive ===== */
    @media (max-width: 1024px) {
      .modal-grid {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(220px, 45vh) auto;
      }
      .modal-info {
        border-left: 0;
        border-top: 1px solid var(--c-line);
        max-height: 55vh;
      }
    }
    @media (max-width: 640px) {
      .filter-bar {
        flex-direction: column;
        align-items: stretch;
      }
      .filter-group {
        width: 100%;
      }
      .select {
        width: 100%;
        min-width: 0;
      }
    }
  </style>

  <script
    id="map-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify(initialData)}
  />
  {
    !plan ? null : (
      <script>
        import {initPublicMap} from "../scripts/public-map"; initPublicMap();
      </script>
    )
  }
</PublicLayout>
