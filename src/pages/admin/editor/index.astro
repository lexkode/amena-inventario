---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import { getPlanoActivo } from "@features/plan/plano.service";
import {
  getLotes,
  getEstadoPublicacion,
  asegurarPublicacionInicial,
} from "@features/lots/lote.service";
import { getModelos } from "@features/catalog/modelo.service";
import { getPuntos } from "@features/points/punto.service";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const plan = await getPlanoActivo();
const lotes = plan ? await getLotes() : [];
const modelos = await getModelos();
const puntos = await getPuntos();
if (plan) await asegurarPublicacionInicial();
const estadoPublicacion = plan
  ? await getEstadoPublicacion()
  : { tienePublicacion: false, pendiente: false };

const initialData = { plan, lotes, modelos, puntos, estadoPublicacion };
---

<AdminLayout title="Editor de Plano" user={user}>
  <div class="page-header">
    <div class="ph-block ph-title">
      <h1>Editor de Plano</h1>
    </div>

    <div class="ph-block" role="group" aria-label="Vista y edición">
      <div class="ph-controls">
        <div class="dropdown" id="view-dropdown" data-dropdown>
          <button
            class="dropdown-toggle"
            id="view-toggle"
            data-dropdown-toggle
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <span class="dropdown-label">Vista</span>
            <span class="dropdown-value" id="view-value">Edición</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="dropdown-menu" id="view-menu" data-dropdown-menu role="menu" hidden>
            <button type="button" role="menuitem" data-view-value="estandar">Edición</button>
            <button type="button" role="menuitem" data-view-value="disponibilidad">Previsualización</button>
          </div>
        </div>
        <div class="zoom-group" role="group" aria-label="Zoom">
          <button id="zoom-out" class="zoom-btn" type="button" aria-label="Zoom out">−</button>
          <span id="zoom-display" class="zoom-display">100%</span>
          <button id="zoom-in" class="zoom-btn" type="button" aria-label="Zoom in">+</button>
          <button id="zoom-fit" class="zoom-btn zoom-fit" type="button" title="Restablecer zoom">Fit</button>
        </div>
        <button
          id="create-lote"
          class="create-lote-btn"
          type="button"
          title="Crear nuevo lote"
          aria-label="Crear nuevo lote"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          <span>Nuevo lote</span>
        </button>
        <button
          id="create-punto"
          class="create-punto-btn"
          type="button"
          title="Agregar punto de interés"
          aria-label="Agregar punto de interés"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Punto de interés</span>
        </button>
        <div class="paste-group" id="paste-group" hidden>
          <button id="paste-lote" class="zoom-btn" type="button" title="Pegar lote copiado (Ctrl+V)">Pegar lote</button>
        </div>
      </div>
    </div>

    <div class="ph-block" role="group" aria-label="Contenido y publicaciones">
      <div class="ph-controls">
        <div class="history-group" role="group" aria-label="Historial de pasos">
          <button id="undo" class="zoom-btn history-icon" type="button" title="Deshacer (Ctrl+Z)" aria-label="Deshacer" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5 5.5 5.5 0 0 1-5.5 5.5H11"/></svg>
          </button>
          <div class="dropdown history-dropdown" id="history-dropdown" data-dropdown>
            <button
              class="dropdown-toggle history-toggle"
              id="history-toggle"
              data-dropdown-toggle
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              disabled
            >
              <span class="dropdown-value" id="history-value">—</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="dropdown-menu" id="history-menu" data-dropdown-menu role="menu" hidden></div>
          </div>
          <button id="redo" class="zoom-btn history-icon" type="button" title="Rehacer (Ctrl+Shift+Z)" aria-label="Rehacer" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5 5.5 5.5 0 0 0 9.5 20H13"/></svg>
          </button>
        </div>
        <div class="publish-group" id="publish-group" data-dropdown>
          <button
            id="save-draft"
            class="btn-primary publish-save"
            type="button"
            title="Guardar borrador"
            aria-label="Guardar borrador"
            disabled
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg>
          </button>
          <button id="publish-action" class="btn-primary publish-main" type="button" disabled>Publicar</button>
          <button
            id="publish-toggle"
            class="btn-primary publish-toggle"
            data-dropdown-toggle
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="Más opciones de contenido"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="dropdown-menu dropdown-menu--right" id="publish-menu" data-dropdown-menu role="menu" hidden>
            <button type="button" role="menuitem" data-publish-action="backup">Respaldar JSON (R2)</button>
            <div class="dropdown-menu-sep" role="separator"></div>
            <button type="button" role="menuitem" data-publish-action="restore">Restaurar publicación</button>
            <button type="button" role="menuitem" data-publish-action="import">Restaurar desde archivo</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {!plan ? (
    <div class="empty">
      <p class="empty-title">No hay un plano configurado todavía.</p>
      <p class="muted">El editor necesita la imagen del plano base para poder dibujar lotes encima.</p>
      <a href="/admin/plano" class="btn-primary">Configurar plano</a>
    </div>
  ) : (
    <div class="editor-container">
      <div class="canvas-wrap" id="canvas-wrap">
        <svg
          id="canvas"
          viewBox={`0 0 ${plan.anchoPx} ${plan.altoPx}`}
          preserveAspectRatio="xMidYMid slice"
        >
          <image id="plan-image" href={plan.imagenPath} x="0" y="0" width={plan.anchoPx} height={plan.altoPx} preserveAspectRatio="xMidYMid meet" />
          <g id="lots-layer"></g>
          <g id="puntos-layer"></g>
          <g id="overlay-layer"></g>
        </svg>
      </div>
      <aside class="side-panel" id="side-panel"></aside>
    </div>
  )}

  <script id="editor-data" type="application/json" is:inline set:html={JSON.stringify(initialData)}></script>
  {!plan ? null : (
    <script>
      import { initEditor } from "../../../scripts/editor";
      initEditor();
    </script>
  )}
</AdminLayout>

<style>
  .ph-block {
    display: flex;
    min-width: 0;
  }
  .ph-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    --control-h: 2.35rem;
  }
  @media (max-width: 900px) {
    .ph-block {
      flex: 1 1 100%;
    }
  }
  .zoom-group {
    display: inline-flex;
    height: var(--control-h);
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
    align-items: center;
  }
  .dropdown {
    position: relative;
    display: inline-flex;
  }
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: var(--control-h);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: var(--c-shadow-soft);
    padding: 0.4rem 0.6rem;
    color: var(--c-text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
  }
  .dropdown-toggle > svg {
    width: 14px;
    height: 14px;
    display: block;
    color: var(--c-text-muted);
    flex-shrink: 0;
  }
  .dropdown-toggle:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .dropdown-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dropdown-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .zoom-btn {
    padding: 0.4rem 0.85rem;
    background: transparent;
    color: var(--c-text-muted);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .zoom-btn:hover {
    color: var(--c-text);
  }
  .zoom-btn {
    min-width: 2rem;
  }
  .create-lote-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: var(--control-h);
    padding: 0 0.95rem;
    background: var(--c-accent);
    color: var(--c-white);
    border: 1px solid var(--c-accent);
    border-radius: var(--r-md);
    box-shadow: var(--c-shadow-soft);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .create-lote-btn svg {
    width: 20px;
    height: 20px;
    display: block;
    flex-shrink: 0;
  }
  .create-lote-btn:hover {
    background: var(--c-accent-hover);
    border-color: var(--c-accent-hover);
  }
  .create-lote-btn.active {
    background: var(--c-accent-hover);
    border-color: var(--c-accent-hover);
  }
  .create-punto-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: var(--control-h);
    padding: 0 0.95rem;
    background: var(--c-surface);
    color: var(--c-text);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: var(--c-shadow-soft);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .create-punto-btn svg {
    width: 20px;
    height: 20px;
    display: block;
    flex-shrink: 0;
  }
  .create-punto-btn:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }
  .create-punto-btn.active {
    background: var(--c-accent);
    color: var(--c-white);
    border-color: var(--c-accent);
  }
  .zoom-display {
    display: inline-flex;
    align-items: center;
    padding: 0 0.6rem;
    color: var(--c-text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 3.5rem;
    justify-content: center;
  }
  .zoom-fit {
    padding: 0.4rem 0.6rem;
  }
  .paste-group {
    display: inline-flex;
    height: var(--control-h);
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
    align-items: center;
  }
  .paste-group[hidden] {
    display: none;
  }
  .paste-group .zoom-btn {
    padding: 0.4rem 0.85rem;
    color: var(--c-text);
  }
  .history-group {
    display: inline-flex;
    height: var(--control-h);
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
    align-items: center;
    gap: 0.15rem;
  }
  .history-icon svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .history-icon:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .history-toggle {
    border: 0;
    box-shadow: none;
    background: transparent;
    border-radius: var(--r-sm);
    padding: 0.15rem 0.3rem;
    font-size: 0.82rem;
    height: auto;
  }
  .history-toggle .dropdown-value {
    max-width: 190px;
  }
  .history-toggle:disabled {
    opacity: 0.45;
  }
  .publish-group {
    position: relative;
    display: inline-flex;
    height: var(--control-h);
    align-items: stretch;
  }
  .publish-save {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.6rem;
    border-radius: var(--r-sm) 0 0 var(--r-sm);
    border-right: 1px solid rgba(255, 255, 255, 0.35);
  }
  .publish-save svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .publish-main {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.35);
  }
  .publish-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.5rem;
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }
  .publish-toggle svg {
    width: 14px;
    height: 14px;
    display: block;
  }
  :global(.dropdown-menu) {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 100%;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: var(--c-shadow-medium);
    padding: 0.25rem;
    display: flex;
    flex-direction: column;
    z-index: 30;
    max-height: 320px;
    overflow-y: auto;
  }
  :global(.dropdown-menu[hidden]) {
    display: none;
  }
  :global(.dropdown-menu--right) {
    left: auto;
    right: 0;
  }
  :global(.dropdown-menu button) {
    text-align: left;
    padding: 0.5rem 0.65rem;
    background: transparent;
    border: 0;
    border-radius: var(--r-sm);
    color: var(--c-text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 150ms ease;
  }
  :global(.dropdown-menu button:hover) {
    background: var(--c-surface-muted);
  }
  :global(.dropdown-menu button.active) {
    background: var(--c-surface-muted);
    font-weight: 700;
  }
  :global(.dropdown-menu-sep) {
    height: 1px;
    background: var(--c-line);
    margin: 0.25rem 0.35rem;
  }

  .canvas-wrap :global(.selection-toolbar) {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.2rem;
    background: var(--c-bg-dark);
    border-radius: var(--r-md);
    box-shadow: var(--c-shadow-medium);
    z-index: 5;
  }
  .canvas-wrap :global(.selection-toolbar[hidden]) {
    display: none;
  }
  .canvas-wrap :global(.selection-toolbar button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--r-sm);
    color: rgba(255, 255, 255, 0.92);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .canvas-wrap :global(.selection-toolbar button:hover) {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .canvas-wrap :global(.selection-toolbar button[data-danger="true"]:hover) {
    background: var(--c-danger);
    color: #fff;
  }
  .canvas-wrap :global(.selection-toolbar button svg) {
    width: 15px;
    height: 15px;
    display: block;
  }

  .editor-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1rem;
    flex: 1;
    min-height: 0;
  }
  .canvas-wrap {
    position: relative;
    background: var(--c-bg-light);
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-medium);
    min-height: 0;
  }
  #canvas {
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  .side-panel {
    background: var(--c-surface);
    border-radius: var(--r-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-medium);
  }
  .side-panel h2 {
    font-size: 1.1rem;
  }
  .empty-title {
    margin: 0 0 1rem;
  }
  .side-panel :global(.field) {
    display: flex;
    flex-direction: column;
    margin-top: 0.85rem;
  }
  .side-panel :global(.field label) {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    margin-bottom: 0.3rem;
    font-weight: 500;
  }
  .side-panel :global(.field input),
  .side-panel :global(.field select) {
    font-size: 0.9rem;
  }
  .side-panel :global(.actions) {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .side-panel :global(.actions button) {
    flex: 1 1 0;
  }
  .side-panel :global(button[disabled]) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .side-panel :global(form.form-col) {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .side-panel :global(.form-head) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-shrink: 0;
  }
  .side-panel :global(.form-head h2) {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    text-align: left;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .side-panel :global(.panel-spacer) {
    flex: 0 0 2.2rem;
    align-self: stretch;
  }
  .side-panel :global(.form-fields) {
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
  }
  .side-panel :global(.form-actions) {
    flex-shrink: 0;
    margin-top: 0.75rem;
  }
  .side-panel :global(.lote-scroll) {
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
  }
  .side-panel :global(.back-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    background: var(--c-surface-muted);
    border: 0;
    border-radius: var(--r-sm);
    color: var(--c-text);
    cursor: pointer;
    line-height: 0;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .side-panel :global(.back-btn:hover) {
    background: var(--c-line);
  }
  .side-panel :global(.lote-acc) {
    border-bottom: 1px solid var(--c-line);
  }
  .side-panel :global(.lote-acc:last-child) {
    border-bottom: 0;
  }
  .side-panel :global(.lote-grupo) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0.7rem 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .side-panel :global(.lote-grupo::-webkit-details-marker) {
    display: none;
  }
  .side-panel :global(.lote-chev) {
    flex-shrink: 0;
    color: var(--c-text-muted);
    transition: transform 150ms ease;
  }
  .side-panel :global(.lote-acc[open] .lote-chev) {
    transform: rotate(180deg);
  }
  .side-panel :global(.lote-list) {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .side-panel :global(.lote-row) {
    width: 100%;
    text-align: left;
    padding: 0.55rem 0.75rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    color: var(--c-text);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
