---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import { getPlanoActivo } from "@modules/plan";
import { getLotes } from "@modules/lots";
import { getModelos } from "@modules/catalog";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const plan = getPlanoActivo();
const lotes = plan ? getLotes() : [];
const modelos = getModelos();

const initialData = { plan, lotes, modelos };
---

<AdminLayout title="Editor de Plano" user={user}>
  <div class="page-header">
    <h1>Editor de Plano</h1>
    <div class="toolbar">
      <div class="mode-group" role="tablist" aria-label="Modo de edición">
        <button data-mode="view" class="mode-btn" type="button">Ver</button>
        <button data-mode="draw" class="mode-btn" type="button">Dibujar</button>
        <button data-mode="edit" class="mode-btn" type="button">Editar</button>
      </div>
      <div class="zoom-group" role="group" aria-label="Zoom">
        <button id="zoom-out" class="zoom-btn" type="button" aria-label="Zoom out">−</button>
        <span id="zoom-display" class="zoom-display">100%</span>
        <button id="zoom-in" class="zoom-btn" type="button" aria-label="Zoom in">+</button>
        <button id="zoom-fit" class="zoom-btn zoom-fit" type="button" title="Restablecer zoom">Fit</button>
      </div>
    </div>
  </div>

  {!plan ? (
    <div class="empty">
      <p class="empty-title">No hay un plano configurado todavía.</p>
      <p class="muted">El editor necesita la imagen del plano base para poder dibujar lotes encima.</p>
      <a href="/admin/plano" class="btn-primary">Configurar plano</a>
    </div>
  ) : (
    <div class="editor-container">
      <div class="canvas-wrap">
        <svg
          id="canvas"
          viewBox={`0 0 ${plan.anchoPx} ${plan.altoPx}`}
          preserveAspectRatio="xMidYMid meet"
        >
          <image id="plan-image" href={plan.imagenPath} x="0" y="0" width={plan.anchoPx} height={plan.altoPx} preserveAspectRatio="xMidYMid meet" />
          <g id="lots-layer"></g>
          <g id="overlay-layer"></g>
        </svg>
      </div>
      <aside class="side-panel" id="side-panel"></aside>
    </div>
  )}

  <script id="editor-data" type="application/json" is:inline set:html={JSON.stringify(initialData)}></script>
  {!plan ? null : (
    <script>
      import { initEditor } from "../../../scripts/editor";
      initEditor();
    </script>
  )}
</AdminLayout>

<style>
  .toolbar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .mode-group,
  .zoom-group {
    display: inline-flex;
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
  }
  .mode-btn,
  .zoom-btn {
    padding: 0.4rem 0.85rem;
    background: transparent;
    color: var(--c-text-muted);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .mode-btn:hover,
  .zoom-btn:hover {
    color: var(--c-text);
  }
  .mode-btn.active {
    background: var(--c-accent);
    color: var(--c-white);
  }
  .zoom-btn {
    min-width: 2rem;
  }
  .zoom-display {
    display: inline-flex;
    align-items: center;
    padding: 0 0.6rem;
    color: var(--c-text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 3.5rem;
    justify-content: center;
  }
  .zoom-fit {
    padding: 0.4rem 0.6rem;
  }

  .editor-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1rem;
    height: calc(100dvh - 220px);
    min-height: 480px;
  }
  .canvas-wrap {
    position: relative;
    background: var(--c-bg-dark);
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--c-bg-dark);
    box-shadow: var(--c-shadow-medium);
    min-height: 0;
  }
  #canvas {
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  .side-panel {
    background: var(--c-surface);
    border-radius: var(--r-lg);
    padding: 1.25rem;
    overflow-y: auto;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-medium);
  }
  .side-panel h2 {
    font-size: 1.1rem;
  }
  .empty-title {
    margin: 0 0 1rem;
  }
  .side-panel .field {
    display: flex;
    flex-direction: column;
    margin-top: 0.85rem;
  }
  .side-panel .field label {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    margin-bottom: 0.3rem;
    font-weight: 500;
  }
  .side-panel .field input,
  .side-panel .field select {
    font-size: 0.9rem;
  }
  .side-panel .actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .form-error {
    margin-top: 0.85rem;
    padding: 0.5rem 0.75rem;
    background: var(--c-danger-soft);
    color: var(--c-danger-fg);
    border: 1px solid var(--c-danger);
    border-radius: var(--r-sm);
    font-size: 0.85rem;
  }
  kbd {
    display: inline-block;
    padding: 0 0.35rem;
    background: var(--c-surface-muted);
    border: 1px solid var(--c-line);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
  }
  @media (max-width: 900px) {
    .editor-container {
      grid-template-columns: 1fr;
      height: auto;
    }
    .canvas-wrap {
      height: 60dvh;
    }
  }
</style>
