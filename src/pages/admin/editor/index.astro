---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import { getPlanoActivo } from "@features/plan/plano.service";
import { getLotes } from "@features/lots/lote.service";
import { getModelos } from "@features/catalog/modelo.service";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const plan = getPlanoActivo();
const lotes = plan ? getLotes() : [];
const modelos = getModelos();

const initialData = { plan, lotes, modelos };
---

<AdminLayout title="Editor de Plano" user={user}>
  <div class="page-header">
    <h1>Editor de Plano</h1>
    <div class="toolbar">
      <div class="view-group" role="group" aria-label="Visualización de polígonos">
        <label class="view-label" for="polygon-view">Vista</label>
        <select id="polygon-view" class="view-select">
          <option value="estandar">Edición</option>
          <option value="disponibilidad">Previsualización</option>
        </select>
      </div>
      <div class="mode-group" role="tablist" aria-label="Modo de edición">
        <button data-mode="lotes" class="mode-btn" type="button">Lotes</button>
        <button data-mode="draw" class="mode-btn" type="button">Dibujar</button>
      </div>
      <div class="zoom-group" role="group" aria-label="Zoom">
        <button id="zoom-out" class="zoom-btn" type="button" aria-label="Zoom out">−</button>
        <span id="zoom-display" class="zoom-display">100%</span>
        <button id="zoom-in" class="zoom-btn" type="button" aria-label="Zoom in">+</button>
        <button id="zoom-fit" class="zoom-btn zoom-fit" type="button" title="Restablecer zoom">Fit</button>
      </div>
    </div>
  </div>

  {!plan ? (
    <div class="empty">
      <p class="empty-title">No hay un plano configurado todavía.</p>
      <p class="muted">El editor necesita la imagen del plano base para poder dibujar lotes encima.</p>
      <a href="/admin/plano" class="btn-primary">Configurar plano</a>
    </div>
  ) : (
    <div class="editor-container">
      <div class="canvas-wrap">
        <svg
          id="canvas"
          viewBox={`0 0 ${plan.anchoPx} ${plan.altoPx}`}
          preserveAspectRatio="xMidYMid meet"
        >
          <image id="plan-image" href={plan.imagenPath} x="0" y="0" width={plan.anchoPx} height={plan.altoPx} preserveAspectRatio="xMidYMid meet" />
          <g id="lots-layer"></g>
          <g id="overlay-layer"></g>
        </svg>
      </div>
      <aside class="side-panel" id="side-panel"></aside>
    </div>
  )}

  <script id="editor-data" type="application/json" is:inline set:html={JSON.stringify(initialData)}></script>
  {!plan ? null : (
    <script>
      import { initEditor } from "../../../scripts/editor";
      initEditor();
    </script>
  )}
</AdminLayout>

<style>
  .toolbar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .mode-group,
  .zoom-group,
  .view-group {
    display: inline-flex;
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
    align-items: center;
  }
  .view-group {
    gap: 0.35rem;
    padding: 0.35rem 0.5rem;
  }
  .view-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .view-select {
    border: 0;
    background: transparent;
    color: var(--c-text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.1rem 0.25rem;
    outline: none;
  }
  .mode-btn,
  .zoom-btn {
    padding: 0.4rem 0.85rem;
    background: transparent;
    color: var(--c-text-muted);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .mode-btn:hover,
  .zoom-btn:hover {
    color: var(--c-text);
  }
  .mode-btn.active {
    background: var(--c-accent);
    color: var(--c-white);
  }
  .zoom-btn {
    min-width: 2rem;
  }
  .zoom-display {
    display: inline-flex;
    align-items: center;
    padding: 0 0.6rem;
    color: var(--c-text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 3.5rem;
    justify-content: center;
  }
  .zoom-fit {
    padding: 0.4rem 0.6rem;
  }

  .editor-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1rem;
    height: calc(100dvh - 140px);
    min-height: 480px;
  }
  .canvas-wrap {
    position: relative;
    background: var(--c-bg-light);
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-medium);
    min-height: 0;
  }
  #canvas {
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  .side-panel {
    background: var(--c-surface);
    border-radius: var(--r-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-medium);
  }
  .side-panel h2 {
    font-size: 1.1rem;
  }
  .empty-title {
    margin: 0 0 1rem;
  }
  .side-panel :global(.field) {
    display: flex;
    flex-direction: column;
    margin-top: 0.85rem;
  }
  .side-panel :global(.field label) {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    margin-bottom: 0.3rem;
    font-weight: 500;
  }
  .side-panel :global(.field input),
  .side-panel :global(.field select) {
    font-size: 0.9rem;
  }
  .side-panel :global(.actions) {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .side-panel :global(.actions button) {
    flex: 1 1 0;
  }
  .side-panel :global(button[disabled]) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .side-panel :global(form.form-col) {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .side-panel :global(.form-head) {
    display: grid;
    grid-template-columns: 2.2rem 1fr 2.2rem;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-shrink: 0;
  }
  .side-panel :global(.form-head h2) {
    margin: 0;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .side-panel :global(.form-fields) {
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
  }
  .side-panel :global(.form-actions) {
    flex-shrink: 0;
    margin-top: 0.75rem;
  }
  .side-panel :global(.lote-scroll) {
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
  }
  .side-panel :global(.back-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    background: var(--c-surface-muted);
    border: 0;
    border-radius: var(--r-sm);
    color: var(--c-text);
    cursor: pointer;
    line-height: 0;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .side-panel :global(.back-btn:hover) {
    background: var(--c-line);
  }
  .side-panel :global(.lote-acc) {
    border-bottom: 1px solid var(--c-line);
  }
  .side-panel :global(.lote-acc:last-child) {
    border-bottom: 0;
  }
  .side-panel :global(.lote-grupo) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0.7rem 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .side-panel :global(.lote-grupo::-webkit-details-marker) {
    display: none;
  }
  .side-panel :global(.lote-chev) {
    flex-shrink: 0;
    color: var(--c-text-muted);
    transition: transform 150ms ease;
  }
  .side-panel :global(.lote-acc[open] .lote-chev) {
    transform: rotate(180deg);
  }
  .side-panel :global(.lote-list) {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .side-panel :global(.lote-row) {
    width: 100%;
    text-align: left;
    padding: 0.55rem 0.75rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    color: var(--c-text);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .side-panel :global(.lote-row:hover) {
    background: var(--c-surface-muted);
    border-color: var(--c-accent);
  }
  .side-panel :global(.lote-vacio) {
    color: var(--c-text-muted);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  .side-panel :global(.lote-imgs) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .side-panel :global(.lote-img) {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: var(--r-sm);
    overflow: hidden;
    border: 1px solid var(--c-line);
    background: var(--c-bg-light);
  }
  .side-panel :global(.lote-img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .side-panel :global(.img-remove) {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 0;
    border-radius: 50%;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
  }
  .side-panel :global(.img-remove:hover) {
    background: var(--c-danger);
  }
  .side-panel :global(.img-add) {
    width: 76px;
    height: 76px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--c-line);
    border-radius: var(--r-sm);
    color: var(--c-text-muted);
    font-size: 1.6rem;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  .side-panel :global(.img-add:hover) {
    color: var(--c-text);
    border-color: var(--c-accent);
    background: var(--c-surface-muted);
  }
  .side-panel :global(.form-error) {
    margin-top: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: var(--c-danger-soft);
    color: var(--c-danger-fg);
    border: 1px solid var(--c-danger);
    border-radius: var(--r-sm);
    font-size: 0.68rem;
    font-weight: 400;
  }
  .side-panel :global(.form-success) {
    margin-top: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: var(--c-success-soft);
    color: var(--c-success);
    border: 1px solid var(--c-success);
    border-radius: var(--r-sm);
    font-size: 0.68rem;
    font-weight: 400;
  }
  kbd {
    display: inline-block;
    padding: 0 0.35rem;
    background: var(--c-surface-muted);
    border: 1px solid var(--c-line);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
  }
  @media (max-width: 900px) {
    .editor-container {
      grid-template-columns: 1fr;
      height: auto;
    }
    .canvas-wrap {
      height: 60dvh;
    }
  }
</style>
