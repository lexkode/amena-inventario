---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import { getPlanoActivo } from "@modules/plan";
import { getLotes } from "@modules/lots";
import { getModelos } from "@modules/catalog";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const plan = getPlanoActivo();
const lotes = plan ? getLotes() : [];
const modelos = getModelos();

const initialData = { plan, lotes, modelos };
---

<AdminLayout title="Editor de Plano" user={user}>
  <div class="page-header">
    <h1>Editor de Plano</h1>
    <div class="toolbar">
      <div class="mode-group" role="tablist" aria-label="Modo de edición">
        <button data-mode="view" class="mode-btn" type="button">Ver</button>
        <button data-mode="draw" class="mode-btn" type="button">Dibujar</button>
        <button data-mode="edit" class="mode-btn" type="button">Editar</button>
      </div>
      <div class="zoom-group" role="group" aria-label="Zoom">
        <button id="zoom-out" class="zoom-btn" type="button" aria-label="Zoom out">−</button>
        <span id="zoom-display" class="zoom-display">100%</span>
        <button id="zoom-in" class="zoom-btn" type="button" aria-label="Zoom in">+</button>
        <button id="zoom-fit" class="zoom-btn zoom-fit" type="button" title="Restablecer zoom">Fit</button>
      </div>
    </div>
  </div>

  {!plan ? (
    <div class="empty">
      <p style="margin:0 0 1rem">No hay un plano configurado todavía.</p>
      <p style="color:#94a3b8;margin:0 0 1.5rem">El editor necesita la imagen del plano base para poder dibujar lotes encima.</p>
      <a href="/admin/plano" class="btn-primary">Configurar plano</a>
    </div>
  ) : (
    <div class="editor-container">
      <div class="canvas-wrap">
        <svg
          id="canvas"
          viewBox={`0 0 ${plan.anchoPx} ${plan.altoPx}`}
          preserveAspectRatio="xMidYMid meet"
        >
          <image id="plan-image" href={plan.imagenPath} x="0" y="0" width={plan.anchoPx} height={plan.altoPx} preserveAspectRatio="xMidYMid meet" />
          <g id="lots-layer"></g>
          <g id="overlay-layer"></g>
        </svg>
      </div>
      <aside class="side-panel" id="side-panel"></aside>
    </div>
  )}

  <script id="editor-data" type="application/json" is:inline set:html={JSON.stringify(initialData)}></script>
  {!plan ? null : (
    <script>
      import { initEditor } from "../../../scripts/editor";
      initEditor();
    </script>
  )}
</AdminLayout>

<style>
  .toolbar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .mode-group,
  .zoom-group {
    display: inline-flex;
    background: #1e293b;
    border-radius: 8px;
    padding: 0.25rem;
    border: 1px solid #334155;
  }
  .mode-btn,
  .zoom-btn {
    padding: 0.4rem 0.85rem;
    background: transparent;
    color: #94a3b8;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .mode-btn:hover,
  .zoom-btn:hover {
    color: #e2e8f0;
  }
  .mode-btn.active {
    background: #38bdf8;
    color: #0f172a;
  }
  .zoom-btn {
    min-width: 2rem;
  }
  .zoom-display {
    display: inline-flex;
    align-items: center;
    padding: 0 0.6rem;
    color: #cbd5e1;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 3.5rem;
    justify-content: center;
  }
  .zoom-fit { padding: 0.4rem 0.6rem; }

  .editor-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1rem;
    height: calc(100dvh - 220px);
    min-height: 480px;
  }
  .canvas-wrap {
    position: relative;
    background: #0f172a;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #334155;
    min-height: 0;
  }
  #canvas {
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  .side-panel {
    background: #1e293b;
    border-radius: 12px;
    padding: 1.25rem;
    overflow-y: auto;
    border: 1px solid #334155;
  }
  .side-panel h2 { font-size: 1.1rem; }
  .side-panel .field { display: flex; flex-direction: column; margin-top: 0.85rem; }
  .side-panel .field label {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 0.3rem;
    font-weight: 500;
  }
  .side-panel .field input,
  .side-panel .field select {
    padding: 0.5rem 0.7rem;
    background: #0f172a;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.9rem;
    font-family: inherit;
  }
  .side-panel .field input:focus,
  .side-panel .field select:focus {
    outline: 2px solid #38bdf8;
    border-color: transparent;
  }
  .side-panel .actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .side-panel .btn-primary,
  .side-panel .btn-secondary,
  .side-panel .btn-danger {
    padding: 0.55rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    border: 0;
  }
  .side-panel .btn-primary { background: #38bdf8; color: #0f172a; }
  .side-panel .btn-primary:disabled { background: #334155; color: #94a3b8; cursor: not-allowed; }
  .side-panel .btn-secondary { background: transparent; color: #94a3b8; border: 1px solid #334155; }
  .side-panel .btn-danger { background: transparent; color: #fca5a5; border: 1px solid #b91c1c; }
  .form-error {
    margin-top: 0.85rem;
    padding: 0.5rem 0.75rem;
    background: #7f1d1d;
    color: #fee2e2;
    border-radius: 6px;
    font-size: 0.85rem;
  }
  kbd {
    display: inline-block;
    padding: 0 0.35rem;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
  }
  @media (max-width: 900px) {
    .editor-container { grid-template-columns: 1fr; height: auto; }
    .canvas-wrap { height: 60dvh; }
  }
</style>
