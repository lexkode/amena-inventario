---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import { getPlanoActivo } from "@features/plan/plano.service";
import {
  getLotes,
  getEstadoPublicacion,
  asegurarPublicacionInicial,
} from "@features/lots/lote.service";
import { getModelos } from "@features/catalog/modelo.service";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const plan = await getPlanoActivo();
const lotes = plan ? await getLotes() : [];
const modelos = await getModelos();
if (plan) await asegurarPublicacionInicial();
const estadoPublicacion = plan
  ? await getEstadoPublicacion()
  : { tienePublicacion: false, pendiente: false };

const initialData = { plan, lotes, modelos, estadoPublicacion };
---

<AdminLayout title="Editor de Plano" user={user}>
  <div class="page-header">
    <div class="ph-block ph-title">
      <h1>Editor de Plano</h1>
    </div>

    <div class="ph-block" role="group" aria-label="Vista y edición">
      <div class="ph-controls">
        <div class="view-group" role="group" aria-label="Visualización de polígonos">
          <label class="view-label" for="polygon-view">Vista</label>
          <select id="polygon-view" class="view-select">
            <option value="estandar">Edición</option>
            <option value="disponibilidad">Previsualización</option>
          </select>
        </div>
        <div class="zoom-group" role="group" aria-label="Zoom">
          <button id="zoom-out" class="zoom-btn" type="button" aria-label="Zoom out">−</button>
          <span id="zoom-display" class="zoom-display">100%</span>
          <button id="zoom-in" class="zoom-btn" type="button" aria-label="Zoom in">+</button>
          <button id="zoom-fit" class="zoom-btn zoom-fit" type="button" title="Restablecer zoom">Fit</button>
        </div>
        <div class="mode-group" role="tablist" aria-label="Modo de edición">
          <button data-mode="lotes" class="mode-btn" type="button">Lotes</button>
          <button data-mode="draw" class="mode-btn" type="button">Dibujar</button>
        </div>
        <div class="paste-group" id="paste-group" hidden>
          <button id="paste-lote" class="zoom-btn" type="button" title="Pegar lote copiado (Ctrl+V)">Pegar lote</button>
        </div>
      </div>
    </div>

    <div class="ph-block" role="group" aria-label="Contenido y publicaciones">
      <div class="ph-controls">
        <div class="history-group" role="group" aria-label="Historial de pasos">
          <button id="undo" class="zoom-btn history-icon" type="button" title="Deshacer (Ctrl+Z)" aria-label="Deshacer" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5 5.5 5.5 0 0 1-5.5 5.5H11"/></svg>
          </button>
          <select id="history-select" class="history-select" aria-label="Saltar a un paso" disabled></select>
          <button id="redo" class="zoom-btn history-icon" type="button" title="Rehacer (Ctrl+Shift+Z)" aria-label="Rehacer" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5 5.5 5.5 0 0 0 9.5 20H13"/></svg>
          </button>
        </div>
        <div class="publish-group" id="publish-group">
          <button id="publish-action" class="btn-primary publish-main" type="button" disabled>Publicar</button>
          <button
            id="publish-toggle"
            class="btn-primary publish-toggle"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="Más opciones de contenido"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="publish-menu" id="publish-menu" role="menu" hidden>
            <button type="button" role="menuitem" data-publish-action="draft">Guardar como borrador</button>
            <button type="button" role="menuitem" data-publish-action="restore">Restaurar publicación</button>
            <div class="publish-menu-sep" role="separator"></div>
            <button type="button" role="menuitem" data-publish-action="backup">Respaldar JSON (R2)</button>
            <button type="button" role="menuitem" data-publish-action="import">Restaurar desde respaldo</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {!plan ? (
    <div class="empty">
      <p class="empty-title">No hay un plano configurado todavía.</p>
      <p class="muted">El editor necesita la imagen del plano base para poder dibujar lotes encima.</p>
      <a href="/admin/plano" class="btn-primary">Configurar plano</a>
    </div>
  ) : (
    <div class="editor-container">
      <div class="canvas-wrap" id="canvas-wrap">
        <svg
          id="canvas"
          viewBox={`0 0 ${plan.anchoPx} ${plan.altoPx}`}
          preserveAspectRatio="xMidYMid meet"
        >
          <image id="plan-image" href={plan.imagenPath} x="0" y="0" width={plan.anchoPx} height={plan.altoPx} preserveAspectRatio="xMidYMid meet" />
          <g id="lots-layer"></g>
          <g id="overlay-layer"></g>
        </svg>
      </div>
      <aside class="side-panel" id="side-panel"></aside>
    </div>
  )}

  <script id="editor-data" type="application/json" is:inline set:html={JSON.stringify(initialData)}></script>
  {!plan ? null : (
    <script>
      import { initEditor } from "../../../scripts/editor";
      initEditor();
    </script>
  )}
</AdminLayout>

<style>
  .ph-block {
    display: flex;
    min-width: 0;
  }
  .ph-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .ph-block {
      flex: 1 1 100%;
    }
  }
  .mode-group,
  .zoom-group,
  .view-group {
    display: inline-flex;
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
    align-items: center;
  }
  .view-group {
    gap: 0.35rem;
    padding: 0.35rem 0.5rem;
  }
  .view-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .view-select {
    border: 0;
    background: transparent;
    color: var(--c-text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.1rem 0.25rem;
    outline: none;
  }
  .mode-btn,
  .zoom-btn {
    padding: 0.4rem 0.85rem;
    background: transparent;
    color: var(--c-text-muted);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .mode-btn:hover,
  .zoom-btn:hover {
    color: var(--c-text);
  }
  .mode-btn.active {
    background: var(--c-accent);
    color: var(--c-white);
  }
  .zoom-btn {
    min-width: 2rem;
  }
  .zoom-display {
    display: inline-flex;
    align-items: center;
    padding: 0 0.6rem;
    color: var(--c-text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 3.5rem;
    justify-content: center;
  }
  .zoom-fit {
    padding: 0.4rem 0.6rem;
  }
  .paste-group {
    display: inline-flex;
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
    align-items: center;
  }
  .paste-group[hidden] {
    display: none;
  }
  .paste-group .zoom-btn {
    padding: 0.4rem 0.85rem;
    color: var(--c-text);
  }
  .history-group {
    display: inline-flex;
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 0.25rem;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-soft);
    align-items: center;
    gap: 0.15rem;
  }
  .history-icon svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .history-icon:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .history-select {
    max-width: 190px;
    border: 0;
    background: transparent;
    color: var(--c-text);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.15rem 0.25rem;
    outline: none;
  }
  .history-select:disabled {
    color: var(--c-text-muted);
    cursor: default;
  }
  .publish-group {
    position: relative;
    display: inline-flex;
    align-items: stretch;
  }
  .publish-main {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  .publish-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.5rem;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.35);
  }
  .publish-toggle svg {
    width: 14px;
    height: 14px;
    display: block;
  }
  .publish-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    min-width: 210px;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: var(--c-shadow-medium);
    padding: 0.25rem;
    display: flex;
    flex-direction: column;
    z-index: 20;
  }
  .publish-menu[hidden] {
    display: none;
  }
  .publish-menu-sep {
    height: 1px;
    background: var(--c-line);
    margin: 0.25rem 0.35rem;
  }
  .publish-menu button {
    text-align: left;
    padding: 0.5rem 0.65rem;
    background: transparent;
    border: 0;
    border-radius: var(--r-sm);
    color: var(--c-text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .publish-menu button:hover {
    background: var(--c-surface-muted);
  }

  .canvas-wrap :global(.selection-toolbar) {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.2rem;
    background: var(--c-bg-dark);
    border-radius: var(--r-md);
    box-shadow: var(--c-shadow-medium);
    z-index: 5;
  }
  .canvas-wrap :global(.selection-toolbar[hidden]) {
    display: none;
  }
  .canvas-wrap :global(.selection-toolbar button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--r-sm);
    color: rgba(255, 255, 255, 0.92);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .canvas-wrap :global(.selection-toolbar button:hover) {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .canvas-wrap :global(.selection-toolbar button[data-danger="true"]:hover) {
    background: var(--c-danger);
    color: #fff;
  }
  .canvas-wrap :global(.selection-toolbar button svg) {
    width: 15px;
    height: 15px;
    display: block;
  }

  .editor-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1rem;
    height: calc(100dvh - 140px);
    min-height: 480px;
  }
  .canvas-wrap {
    position: relative;
    background: var(--c-bg-light);
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-medium);
    min-height: 0;
  }
  #canvas {
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  .side-panel {
    background: var(--c-surface);
    border-radius: var(--r-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--c-line);
    box-shadow: var(--c-shadow-medium);
  }
  .side-panel h2 {
    font-size: 1.1rem;
  }
  .empty-title {
    margin: 0 0 1rem;
  }
  .side-panel :global(.field) {
    display: flex;
    flex-direction: column;
    margin-top: 0.85rem;
  }
  .side-panel :global(.field label) {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    margin-bottom: 0.3rem;
    font-weight: 500;
  }
  .side-panel :global(.field input),
  .side-panel :global(.field select) {
    font-size: 0.9rem;
  }
  .side-panel :global(.actions) {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .side-panel :global(.actions button) {
    flex: 1 1 0;
  }
  .side-panel :global(button[disabled]) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .side-panel :global(form.form-col) {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .side-panel :global(.form-head) {
    display: grid;
    grid-template-columns: 2.2rem 1fr 2.2rem;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-shrink: 0;
  }
  .side-panel :global(.form-head h2) {
    margin: 0;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .side-panel :global(.form-fields) {
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
  }
  .side-panel :global(.form-actions) {
    flex-shrink: 0;
    margin-top: 0.75rem;
  }
  .side-panel :global(.lote-scroll) {
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
  }
  .side-panel :global(.back-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    background: var(--c-surface-muted);
    border: 0;
    border-radius: var(--r-sm);
    color: var(--c-text);
    cursor: pointer;
    line-height: 0;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .side-panel :global(.back-btn:hover) {
    background: var(--c-line);
  }
  .side-panel :global(.lote-acc) {
    border-bottom: 1px solid var(--c-line);
  }
  .side-panel :global(.lote-acc:last-child) {
    border-bottom: 0;
  }
  .side-panel :global(.lote-grupo) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0.7rem 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .side-panel :global(.lote-grupo::-webkit-details-marker) {
    display: none;
  }
  .side-panel :global(.lote-chev) {
    flex-shrink: 0;
    color: var(--c-text-muted);
    transition: transform 150ms ease;
  }
  .side-panel :global(.lote-acc[open] .lote-chev) {
    transform: rotate(180deg);
  }
  .side-panel :global(.lote-list) {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .side-panel :global(.lote-row) {
    width: 100%;
    text-align: left;
    padding: 0.55rem 0.75rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    color: var(--c-text);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .side-panel :global(.lote-row:hover) {
    background: var(--c-surface-muted);
    border-color: var(--c-accent);
  }
  .side-panel :global(.lote-vacio) {
    color: var(--c-text-muted);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  .side-panel :global(.lote-imgs) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .side-panel :global(.lote-img) {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: var(--r-sm);
    overflow: hidden;
    border: 1px solid var(--c-line);
    background: var(--c-bg-light);
  }
  .side-panel :global(.lote-img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .side-panel :global(.img-remove) {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 0;
    border-radius: 50%;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
  }
  .side-panel :global(.img-remove:hover) {
    background: var(--c-danger);
  }
  .side-panel :global(.img-add) {
    width: 76px;
    height: 76px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--c-line);
    border-radius: var(--r-sm);
    color: var(--c-text-muted);
    font-size: 1.6rem;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  .side-panel :global(.img-add:hover) {
    color: var(--c-text);
    border-color: var(--c-accent);
    background: var(--c-surface-muted);
  }
  .side-panel :global(.form-error) {
    margin-top: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: var(--c-danger-soft);
    color: var(--c-danger-fg);
    border: 1px solid var(--c-danger);
    border-radius: var(--r-sm);
    font-size: 0.68rem;
    font-weight: 400;
  }
  .side-panel :global(.form-success) {
    margin-top: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: var(--c-success-soft);
    color: var(--c-success);
    border: 1px solid var(--c-success);
    border-radius: var(--r-sm);
    font-size: 0.68rem;
    font-weight: 400;
  }
  kbd {
    display: inline-block;
    padding: 0 0.35rem;
    background: var(--c-surface-muted);
    border: 1px solid var(--c-line);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
  }
  @media (max-width: 900px) {
    .editor-container {
      grid-template-columns: 1fr;
      height: auto;
    }
    .canvas-wrap {
      height: 60dvh;
    }
  }
</style>
