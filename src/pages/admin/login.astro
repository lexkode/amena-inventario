---
import "@styles/global.css";
import logo from "@assets/logo-AMENA.webp";

const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "missing"
    ? "Por favor ingresa email y contraseña."
    : error === "invalid"
      ? "Email o contraseña inválidos."
      : error === "error"
        ? "Ocurrió un error procesando la solicitud."
        : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#244858" />
    <title>Login · Amena Inventario</title>
  </head>
  <body class="login-body">
    <div class="login-shell">
      <img src={logo.src} alt="Residencial Amena" class="login-logo" />
      <main class="card login-card">
        <h1>Iniciar sesión</h1>
        {errorMessage && <div class="alert" role="alert">{errorMessage}</div>}
        <form method="POST" action="/api/auth/login" autocomplete="on">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            autofocus
          />
          <label for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
          />
          <button type="submit" class="btn-primary">Entrar</button>
        </form>
      </main>
    </div>
  </body>
</html>

<style>
  .login-body {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    background: var(--c-bg-dark);
  }
  .login-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: min(92vw, 380px);
  }
  .login-logo {
    display: block;
    max-width: 200px;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }
  .login-card {
    width: 100%;
    padding: 2rem;
    text-align: left;
  }
  .login-card h1 {
    margin: 0 0 1.5rem;
    font-size: 1.5rem;
    text-align: center;
  }
  .login-card label {
    display: block;
    font-size: 0.9rem;
    margin: 1rem 0 0.35rem;
    color: var(--c-text-muted);
    font-weight: 500;
  }
  .login-card input {
    width: 100%;
  }
  .login-card button {
    margin-top: 1.5rem;
    width: 100%;
    padding: 0.8rem;
    font-size: 1rem;
  }
</style>
