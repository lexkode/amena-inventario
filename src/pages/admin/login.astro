---
const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "missing"
    ? "Por favor ingresa email y contraseña."
    : error === "invalid"
      ? "Email o contraseña inválidos."
      : error === "error"
        ? "Ocurrió un error procesando la solicitud."
        : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login · Amena Inventario</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        display: grid; place-items: center; min-height: 100dvh;
        margin: 0; background: #0f172a; color: #e2e8f0;
      }
      .card {
        width: min(92vw, 380px);
        background: #1e293b; padding: 2rem; border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,.4);
      }
      h1 { margin: 0 0 1.5rem; font-size: 1.5rem; text-align: center; }
      label { display: block; font-size: .9rem; margin: 1rem 0 .35rem; color: #94a3b8; }
      input {
        width: 100%; box-sizing: border-box; padding: .7rem .85rem;
        background: #0f172a; color: #e2e8f0; border: 1px solid #334155;
        border-radius: 8px; font-size: 1rem;
      }
      input:focus { outline: 2px solid #38bdf8; border-color: transparent; }
      button {
        margin-top: 1.5rem; width: 100%; padding: .8rem; font-size: 1rem;
        background: #38bdf8; color: #0f172a; border: 0; border-radius: 8px;
        font-weight: 600; cursor: pointer;
      }
      button:hover { background: #7dd3fc; }
      .alert {
        margin-bottom: 1rem; padding: .65rem .85rem; border-radius: 8px;
        background: #7f1d1d; color: #fee2e2; font-size: .9rem;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>Iniciar sesión</h1>
      {errorMessage && <div class="alert" role="alert">{errorMessage}</div>}
      <form method="POST" action="/api/auth/login" autocomplete="on">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          autofocus
        />
        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
        />
        <button type="submit">Entrar</button>
      </form>
    </main>
  </body>
</html>
