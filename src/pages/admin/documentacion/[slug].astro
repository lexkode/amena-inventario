---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import { getDoc, listDocs } from "@features/docs/docs.service";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const slug = Astro.params.slug as string;
const doc = await getDoc(slug);

if (!doc) {
  return Astro.redirect("/admin/documentacion");
}

const docs = await listDocs();
---

<AdminLayout title={doc.title} user={user}>
  <div class="docs-layout">
    <nav class="docs-nav" aria-label="Índice de documentación">
      <span class="docs-nav-title">Documentación</span>
      {
        docs.map((item) => (
          <a
            href={`/admin/documentacion/${item.slug}`}
            class={`docs-nav-link ${item.slug === doc.slug ? "active" : ""}`}
            aria-current={item.slug === doc.slug ? "page" : undefined}
          >
            <span class="docs-nav-index">{String(item.index).padStart(2, "0")}</span>
            <span>{item.title}</span>
          </a>
        ))
      }
    </nav>

    <article class="doc-content card">
      <div class="doc-content-head">
        <span class="doc-kicker">Documento {String(doc.index).padStart(2, "0")}</span>
        <h1>{doc.title}</h1>
      </div>
      <div class="md-body" set:html={doc.html} />
      <div class="doc-footer">
        <a href="/admin/documentacion" class="btn-cancel">← Volver al índice</a>
      </div>
    </article>
  </div>
</AdminLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .docs-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    padding: 0.75rem;
    position: sticky;
    top: 1rem;
  }
  .docs-nav-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
    font-weight: 600;
    padding: 0.3rem 0.5rem 0.6rem;
  }
  .docs-nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--r-sm);
    color: var(--c-text);
    text-decoration: none;
    font-size: 0.85rem;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .docs-nav-link:hover {
    background: var(--c-bg-light);
  }
  .docs-nav-link.active {
    background: var(--c-accent);
    color: var(--c-white);
  }
  .docs-nav-index {
    font-weight: 700;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  .docs-nav-link.active .docs-nav-index {
    opacity: 1;
  }

  .doc-content {
    padding: 1.75rem 2rem;
    min-width: 0;
  }
  .doc-content-head {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--c-line);
  }
  .doc-kicker {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-accent);
    font-weight: 700;
  }
  .doc-content-head h1 {
    margin: 0.25rem 0 0;
    font-size: 1.6rem;
  }
  .doc-footer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
  }

  :global(.md-body) {
    font-size: 0.95rem;
    line-height: 1.65;
  }
  :global(.md-body h1),
  :global(.md-body h2),
  :global(.md-body h3),
  :global(.md-body h4) {
    line-height: 1.3;
    margin: 1.6em 0 0.6em;
  }
  :global(.md-body h2) {
    font-size: 1.25rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--c-line);
  }
  :global(.md-body h3) {
    font-size: 1.05rem;
  }
  :global(.md-body p) {
    margin: 0.6em 0;
  }
  :global(.md-body ul),
  :global(.md-body ol) {
    margin: 0.6em 0;
    padding-left: 1.4em;
  }
  :global(.md-body li) {
    margin: 0.25em 0;
  }
  :global(.md-body code) {
    background: var(--c-bg-light);
    border: 1px solid var(--c-line);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    font-size: 0.85em;
  }
  :global(.md-body pre) {
    background: var(--c-bg-dark);
    color: var(--c-white);
    padding: 1rem;
    border-radius: var(--r-md);
    overflow-x: auto;
    margin: 1em 0;
  }
  :global(.md-body pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: 0.85em;
  }
  :global(.md-body blockquote) {
    margin: 1em 0;
    padding: 0.6rem 1rem;
    border-left: 4px solid var(--c-accent);
    background: var(--c-bg-light);
    border-radius: var(--r-sm);
    color: var(--c-text-muted);
  }
  :global(.md-body a) {
    color: var(--c-accent);
  }
  :global(.md-body .md-table) {
    overflow-x: auto;
    margin: 1em 0;
  }
  :global(.md-body table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.88rem;
  }
  :global(.md-body th),
  :global(.md-body td) {
    border: 1px solid var(--c-line);
    padding: 0.5rem 0.7rem;
    text-align: left;
  }
  :global(.md-body th) {
    background: var(--c-bg-light);
    font-weight: 600;
  }
  :global(.md-body hr) {
    border: 0;
    border-top: 1px solid var(--c-line);
    margin: 1.5em 0;
  }

  @media (max-width: 900px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }
    .docs-nav {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem;
    }
    .docs-nav-title {
      width: 100%;
    }
    .doc-content {
      padding: 1.25rem;
    }
  }
</style>
