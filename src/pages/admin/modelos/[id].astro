---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import ModeloForm from "@shared/components/ModeloForm.astro";
import { getModeloById } from "@features/catalog/modelo.service";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const id = Number(Astro.params.id);
const modelo = Number.isInteger(id) && id > 0 ? await getModeloById(id) : null;

if (!modelo) {
  return Astro.redirect("/admin/modelos?error=Modelo no encontrado");
}

const error = Astro.url.searchParams.get("error");
---

<AdminLayout title={`Editar · ${modelo.nombre}`} user={user}>
  <div class="page-header">
    <h1>Editar: {modelo.nombre}</h1>
    <a href="/admin/modelos" class="btn-secondary">← Volver</a>
  </div>

  <ModeloForm
    action={`/api/admin/modelos/${modelo.id}`}
    hiddenMethod="PATCH"
    modelo={modelo}
    submitLabel="Guardar cambios"
    error={error}
  />
</AdminLayout>
