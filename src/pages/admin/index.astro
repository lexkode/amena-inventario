---
import AdminLayout from "@shared/layouts/AdminLayout.astro";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}
---

<AdminLayout title="Dashboard" user={user}>
  <div class="page-header">
    <h1>Dashboard</h1>
  </div>

  <section class="card">
    <h2 class="card-title">Bienvenido</h2>
    <p class="muted welcome-line">
      Sesión iniciada como <strong>{user.email}</strong>
      <span class="role-badge">{user.role}</span>
    </p>
  </section>

  <section class="card">
    <h2 class="card-title">Módulos</h2>
    <ul class="module-list">
      <li>
        <a href="/admin/modelos">📦 Catálogo de modelos</a>
        <p class="muted">Gestionar casas y apartamentos.</p>
      </li>
      <li>
        <a href="/admin/plano">🗺 Plano base del residencial</a>
        <p class="muted">Configurar imagen y dimensiones del plano.</p>
      </li>
      <li>
        <a href="/admin/editor">✏️ Editor de lotes</a>
        <p class="muted">Dibujar y editar los polígonos sobre el plano.</p>
      </li>
    </ul>
  </section>
</AdminLayout>

<style>
  .card-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .welcome-line {
    margin: 0;
  }
  .role-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: var(--c-white);
    font-size: 0.75rem;
    font-weight: 600;
    margin-left: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .module-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }
  .module-list p {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
  }
</style>
