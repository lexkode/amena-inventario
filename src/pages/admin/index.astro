---
import AdminLayout from "@shared/layouts/AdminLayout.astro";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}
---

<AdminLayout title="Dashboard" user={user}>
  <div class="page-header">
    <h1>Dashboard</h1>
  </div>

  <section class="card">
    <h2 style="margin-top:0;font-size:1.15rem">Bienvenido</h2>
    <p style="color:#94a3b8;margin:0">Sesión iniciada como <strong>{user.email}</strong>
      <span class="role-badge">{user.role}</span>
    </p>
  </section>

  <section class="card">
    <h2 style="margin-top:0;font-size:1.15rem">Módulos</h2>
    <ul style="list-style:none;padding:0;display:grid;gap:.65rem">
      <li>
        <a href="/admin/modelos">📦 Catálogo de modelos</a>
        <p style="color:#94a3b8;margin:.15rem 0 0">Gestionar casas y apartamentos.</p>
      </li>
      <li>
        <a href="/admin/plano">🗺 Plano base del residencial</a>
        <p style="color:#94a3b8;margin:.15rem 0 0">Configurar imagen y dimensiones del plano.</p>
      </li>
    </ul>
  </section>
</AdminLayout>

<style>
  .role-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #0ea5e9;
    color: #0f172a;
    font-size: 0.8rem;
    font-weight: 600;
    margin-left: 0.5rem;
  }
</style>
