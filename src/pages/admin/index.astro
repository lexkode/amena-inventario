---
import AdminLayout from "@shared/layouts/AdminLayout.astro";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}
---

<AdminLayout title="Dashboard" user={user}>
  <div class="page-header">
    <h1>Dashboard</h1>
  </div>

  <section class="card">
    <h2 class="card-title">Bienvenido</h2>
    <p class="muted welcome-line">
      Sesión iniciada como <strong>{user.email}</strong>
    </p>
  </section>
</AdminLayout>

<style>
  .card-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .welcome-line {
    margin: 0;
  }
</style>
