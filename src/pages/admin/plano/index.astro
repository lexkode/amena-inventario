---
import AdminLayout from "@shared/layouts/AdminLayout.astro";
import { getPlanoActivo } from "@features/plan/plano.service";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

const plan = await getPlanoActivo();
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<AdminLayout title="Plano Base" user={user}>
  <div class="page-header">
    <h1>Plano Base del Residencial</h1>
  </div>

  {error && <div class="alert" role="alert">{error}</div>}
  {ok && <div class="alert alert-info" role="status">Plano guardado correctamente.</div>}

  <div class="plano-grid">
    {plan && (
      <section class="card">
        <h2 class="card-title">Plano actual</h2>
        <dl class="kv">
          <dt>Nombre</dt><dd>{plan.nombre}</dd>
          <dt>Dimensiones originales</dt>
          <dd>{plan.anchoPx} × {plan.altoPx} px</dd>
          <dt>Opacidad en el sitio público</dt>
          <dd>{plan.opacidad}%</dd>
          <dt>Actualizado</dt>
          <dd>{new Date(plan.createdAt).toLocaleString("es-SV")}</dd>
        </dl>
        <div class="preview">
          <img
            src={plan.imagenPath}
            alt={plan.nombre}
            style={`opacity: ${plan.opacidad / 100}`}
          />
        </div>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">
        {plan ? "Actualizar plano" : "Subir primer plano"}
      </h2>

      <form method="POST" action="/api/admin/plano" enctype="multipart/form-data" class="plano-form">
        <div class="field full">
          <label for="nombre">Nombre</label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            maxlength="120"
            value={plan?.nombre ?? "Plano General Residencial Amena"}
          />
        </div>

        <div class="field full">
          <label for="imagen">Imagen del plano {plan ? "(opcional, dejar vacío para conservar la actual)" : "(requerido)"}</label>
          <input
            id="imagen"
            name="imagen"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml"
            required={!plan}
          />
          <small class="hint">
            PNG, JPG, WEBP, GIF o SVG. Máximo 10MB. El ancho y alto se detectan automáticamente.
          </small>
        </div>

        <div class="field">
          <label for="anchoPx">Ancho original (px)</label>
          <input
            id="anchoPx"
            name="anchoPx"
            type="number"
            min="1"
            step="1"
            required
            value={plan?.anchoPx ?? ""}
          />
        </div>
        <div class="field">
          <label for="altoPx">Alto original (px)</label>
          <input
            id="altoPx"
            name="altoPx"
            type="number"
            min="1"
            step="1"
            required
            value={plan?.altoPx ?? ""}
          />
        </div>

        <div class="field full">
          <label for="opacidad">
            Opacidad en el sitio público: <output id="opacidad-val">{plan?.opacidad ?? 80}%</output>
          </label>
          <input
            id="opacidad"
            name="opacidad"
            type="range"
            min="0"
            max="100"
            step="5"
            value={plan?.opacidad ?? 80}
          />
          <small class="hint">
            Baja la opacidad de la imagen del plano en el sitio público. 100% = totalmente opaco.
          </small>
        </div>

        <div class="actions full">
          <a href="/admin" class="btn-cancel">Cancelar</a>
          <button type="submit" class="btn-primary">{plan ? "Guardar cambios" : "Subir plano"}</button>
        </div>
      </form>
    </section>
  </div>
</AdminLayout>

<script>
  const opacidadInput = document.getElementById("opacidad") as HTMLInputElement | null;
  const opacidadOut = document.getElementById("opacidad-val");
  const updateOpacidad = (): void => {
    if (!opacidadInput) return;
    if (opacidadOut) opacidadOut.textContent = `${opacidadInput.value}%`;
    opacidadInput.style.setProperty("--fill", `${opacidadInput.value}%`);
  };
  if (opacidadInput) {
    opacidadInput.addEventListener("input", updateOpacidad);
    updateOpacidad();
  }

  const imagenInput = document.getElementById("imagen") as HTMLInputElement | null;
  const anchoInput = document.getElementById("anchoPx") as HTMLInputElement | null;
  const altoInput = document.getElementById("altoPx") as HTMLInputElement | null;

  const applySize = (w: number, h: number): void => {
    if (w > 0 && anchoInput) anchoInput.value = String(Math.round(w));
    if (h > 0 && altoInput) altoInput.value = String(Math.round(h));
  };

  const parseLength = (value: string | null): number | null => {
    if (!value) return null;
    const match = value.trim().match(/^([\d.]+)(px)?$/i);
    if (!match) return null;
    const n = Number(match[1]);
    return Number.isFinite(n) && n > 0 ? n : null;
  };

  const sizeFromSvgText = (text: string): { w: number; h: number } | null => {
    try {
      const doc = new DOMParser().parseFromString(text, "image/svg+xml");
      const svg = doc.documentElement;
      if (!svg || svg.nodeName.toLowerCase() !== "svg") return null;
      const viewBox = svg.getAttribute("viewBox") ?? svg.getAttribute("viewbox");
      if (viewBox) {
        const parts = viewBox.trim().split(/[\s,]+/).map(Number);
        if (parts.length === 4 && parts[2] > 0 && parts[3] > 0) {
          return { w: parts[2], h: parts[3] };
        }
      }
      const w = parseLength(svg.getAttribute("width"));
      const h = parseLength(svg.getAttribute("height"));
      if (w && h) return { w, h };
      return null;
    } catch {
      return null;
    }
  };

  const sizeFromImage = (file: File): Promise<{ w: number; h: number } | null> => {
    return new Promise((resolve) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        resolve(
          img.naturalWidth > 0 && img.naturalHeight > 0
            ? { w: img.naturalWidth, h: img.naturalHeight }
            : null,
        );
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(null);
      };
      img.src = url;
    });
  };

  const detectDimensions = async (file: File): Promise<void> => {
    const isSvg =
      file.type === "image/svg+xml" || /\.svg$/i.test(file.name);
    if (isSvg) {
      const text = await file.text().catch(() => "");
      const size = text ? sizeFromSvgText(text) : null;
      if (size) {
        applySize(size.w, size.h);
        return;
      }
    }
    const size = await sizeFromImage(file);
    if (size) applySize(size.w, size.h);
  };

  imagenInput?.addEventListener("change", () => {
    const file = imagenInput.files?.[0];
    if (file) void detectDimensions(file);
  });
</script>

<style>
  .plano-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .card-title {
    margin: 0 0 1rem;
    font-size: 1.1rem;
  }
  .kv {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }
  .kv dt {
    color: var(--c-text-muted);
  }
  .kv dd {
    margin: 0;
  }
  .preview {
    margin-top: 0.75rem;
    background: var(--c-bg-light);
    padding: 0.5rem;
    border-radius: var(--r-md);
    border: 1px solid var(--c-line);
    overflow: auto;
    max-height: 70vh;
  }
  .preview img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .plano-form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
  }
  .field.full {
    grid-column: 1 / -1;
  }
  .field label {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    margin-bottom: 0.35rem;
    font-weight: 500;
  }
  .field small.hint {
    color: var(--c-text-muted);
    margin-top: 0.35rem;
    font-size: 0.8rem;
  }
  .plano-form input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    margin: 0.4rem 0 0;
    border: 0;
    border-radius: var(--r-pill);
    background: linear-gradient(
      to right,
      var(--c-accent) 0%,
      var(--c-accent) var(--fill, 80%),
      var(--c-line) var(--fill, 80%),
      var(--c-line) 100%
    );
    cursor: pointer;
  }
  .plano-form input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border: 2px solid var(--c-white);
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: var(--c-shadow-medium);
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .plano-form input[type="range"]::-webkit-slider-thumb:hover {
    background: var(--c-accent-hover);
  }
  .plano-form input[type="range"]::-moz-range-track {
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--c-line);
  }
  .plano-form input[type="range"]::-moz-range-progress {
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
  }
  .plano-form input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border: 2px solid var(--c-white);
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: var(--c-shadow-medium);
    cursor: pointer;
  }
  .plano-form input[type="range"]::-moz-range-thumb:hover {
    background: var(--c-accent-hover);
  }
  #opacidad-val {
    color: var(--c-accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-start;
    margin-top: 0.5rem;
  }
  @media (max-width: 900px) {
    .plano-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .plano-form {
      grid-template-columns: 1fr;
    }
  }
</style>
