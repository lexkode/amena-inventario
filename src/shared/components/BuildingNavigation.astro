---
const { editor = false } = Astro.props;
---
<div class:list={["tower-context", editor ? "tower-context-editor" : "tower-context-public"]} id="tower-context" hidden>
  <span id="tower-context-label"></span>
  {!editor && (
    <div class="tower-counts" aria-label="Apartamentos de la planta según los filtros" aria-live="polite" aria-atomic="true">
      <div class="tower-count tower-count-disponible">
        <span>Disponibles</span>
        <strong data-floor-count="disponible">0</strong>
      </div>
      <div class="tower-count tower-count-reservado">
        <span>Reservados</span>
        <strong data-floor-count="reservado">0</strong>
      </div>
      <div class="tower-count tower-count-vendido">
        <span>Vendidos</span>
        <strong data-floor-count="vendido">0</strong>
      </div>
    </div>
  )}
  {editor && <button type="button" id="edit-tower" class="btn-secondary">Editar edificio</button>}
  {editor && <button type="button" id="exit-tower" class="btn-secondary">Salir del edificio</button>}
</div>
{!editor && <button type="button" id="exit-tower" class="modal-close building-close" aria-label="Cerrar edificio" hidden>×</button>}
<nav class:list={["tower-levels", !editor && "tower-levels-public"]} id="tower-levels" aria-label="Niveles del edificio" hidden></nav>
<style>
  .tower-context {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    flex-wrap: wrap;
    padding: .65rem .9rem;
    border-radius: .6rem;
    color: white;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .tower-context-editor {
    background: var(--c-bg-dark, #244858);
    border: 1px solid rgba(255, 255, 255, .15);
    border-radius: var(--r-lg, 12px);
    box-shadow: var(--c-shadow-medium);
  }
  .tower-context-editor .btn-secondary {
    color: var(--c-white);
    background: rgba(255, 255, 255, .1);
    border-color: rgba(255, 255, 255, .35);
  }
  .tower-context-editor .btn-secondary:hover:not(:disabled) {
    color: var(--c-white);
    background: rgba(255, 255, 255, .2);
    border-color: rgba(255, 255, 255, .65);
  }
  .tower-context-editor .btn-secondary:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 3px;
  }
  .tower-context-public {
    flex-direction: column;
    flex-wrap: nowrap;
    gap: .6rem;
    bottom: max(1rem, env(safe-area-inset-bottom));
  }
  .tower-counts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .4rem;
    width: min(100%, 28rem);
  }
  .tower-count {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    padding: 6px 12px;
    border: 0;
    border-radius: 6px;
    background: var(--count-color);
    color: var(--c-white);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .tower-count strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: .05rem .45rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, .22);
    font-size: .72rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tower-count-disponible { --count-color: var(--c-disponible); }
  .tower-count-reservado { --count-color: var(--c-reservado); }
  .tower-count-vendido { --count-color: var(--c-vendido); }
  .tower-levels {
    position: absolute;
    left: .75rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-height: 50%;
    overflow-y: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .tower-levels :global(button) {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: white;
    cursor: pointer;
    white-space: nowrap;
    text-transform: uppercase;
    font-weight: 500;
  }
  .tower-levels :global(button:hover),
  .tower-levels :global(button[aria-current="true"]) {
    color: var(--c-accent, #dc832f);
    background: transparent;
  }
  .tower-levels :global(button[aria-current="true"]) { font-weight: 700; }
  .tower-levels-public {
    top: 47%;
    gap: 1rem;
  }
  .tower-levels-public :global(button) {
    opacity: .4;
  }
  .tower-levels-public :global(button:hover),
  .tower-levels-public :global(button[aria-current="true"]) {
    color: white;
    background: transparent;
  }
  .tower-levels-public :global(button:hover),
  .tower-levels-public :global(button[aria-current="true"]) {
    opacity: 1;
  }
  @media (min-width: 768px) {
    .tower-levels-public { left: 2rem; }
  }
  @media (max-width: 640px) {
    .tower-count {
      font-size: 10px;
      padding: 6px;
      gap: .25rem;
    }
    .tower-count strong {
      min-width: 1.2rem;
      padding: .05rem .25rem;
      font-size: .65rem;
    }
    .tower-levels-public {
      top: 50%;
      right: 1rem;
      bottom: auto;
      left: 1rem;
      transform: translateY(-50%);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      max-height: min(35vh, calc(100% - 8rem));
      overflow-x: hidden;
      overflow-y: auto;
    }
  }
  .tower-context[hidden], .tower-levels[hidden] { display: none; }
</style>
