---
import logo from "@assets/logo-AMENA.webp";
import logoColapsado from "@assets/logo-AMENA-colapsado.webp";
import type { User } from "@db/schema";

type Props = {
  user: User;
};

const { user } = Astro.props;
const currentPath = Astro.url.pathname;

type NavItem = {
  href: string;
  label: string;
  icon: string;
  match: (pathname: string) => boolean;
};

const navItems: NavItem[] = [
  {
    href: "/admin",
    label: "Dashboard",
    icon: "dashboard",
    match: (p) => p === "/admin",
  },
  {
    href: "/admin/plano",
    label: "Plano Base",
    icon: "plano",
    match: (p) => p === "/admin/plano" || p.startsWith("/admin/plano/"),
  },
  {
    href: "/admin/modelos",
    label: "Modelos",
    icon: "modelos",
    match: (p) => p === "/admin/modelos" || p.startsWith("/admin/modelos/"),
  },
  {
    href: "/admin/editor",
    label: "Editor",
    icon: "editor",
    match: (p) => p === "/admin/editor" || p.startsWith("/admin/editor/"),
  },
  {
    href: "/admin/documentacion",
    label: "Documentación",
    icon: "docs",
    match: (p) => p === "/admin/documentacion" || p.startsWith("/admin/documentacion/"),
  },
];

const icons: Record<string, string> = {
  dashboard: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>`,
  modelos: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>`,
  plano: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>`,
  editor: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.707 21.293a1 1 0 0 1-1.414 0l-1.586-1.586a1 1 0 0 1 0-1.414l5.586-5.586a1 1 0 0 1 1.414 0l1.586 1.586a1 1 0 0 1 0 1.414z"/><path d="m18 13-1.375-6.874a1 1 0 0 0-.746-.776L3.235 2.028a1 1 0 0 0-1.207 1.207L5.35 15.879a1 1 0 0 0 .776.746L13 18"/><path d="m2.3 2.3 7.286 7.286"/><circle cx="11" cy="11" r="2"/></svg>`,
  docs: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`,
};
---

<aside class="admin-sidebar" id="admin-sidebar" aria-label="Navegación lateral">
  <div class="sidebar-inner">
    <!-- Brand -->
    <a href="/admin" class="sidebar-brand" aria-label="Residencial Amena — Inicio">
      <img src={logo.src} alt="Residencial Amena" class="brand-full" />
      <img src={logoColapsado.src} alt="Residencial Amena" class="brand-icon" />
    </a>

    <!-- Navigation -->
    <nav class="sidebar-nav" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-item ${item.match(currentPath) ? "active" : ""}`}
            data-label={item.label}
            aria-current={item.match(currentPath) ? "page" : undefined}
          >
            <span class="nav-icon" set:html={icons[item.icon]} />
            <span class="nav-label">{item.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- User info -->
    <div class="sidebar-user">
      <div class="user-meta">
        <span class="user-email" title={user.email}>{user.email}</span>
        <span class="role-badge">{user.role}</span>
      </div>
      <div class="user-row">
        <form method="POST" action="/api/auth/logout" class="logout-form">
          <button type="submit" class="logout-btn" aria-label="Cerrar sesión">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" x2="9" y1="12" y2="12" />
            </svg>
            <span class="logout-label">Salir</span>
          </button>
        </form>

        <!-- Toggle (desktop) -->
        <button
          class="sidebar-toggle"
          id="sidebar-toggle"
          type="button"
          aria-label="Expandir menú"
          aria-expanded="false"
        >
          <svg
            class="chevron"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</aside>

<!-- Overlay for mobile -->
<div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

<style>
  /* ---- Sidebar shell ---- */
  .admin-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 40;
    width: 240px;
    background: var(--c-bg-dark);
    color: var(--c-header-fg);
    transform: translateX(-100%);
    transition: transform 300ms ease, width 300ms ease;
  }
  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem 0.75rem;
    gap: 1rem;
  }

  /* ---- Brand ---- */
  .sidebar-brand {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 40px;
    border-radius: var(--r-md);
    transition: background-color 150ms ease;
  }
  .sidebar-brand:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .brand-full {
    display: block;
    height: 30px;
    width: auto;
  }
  .brand-icon {
    display: none;
    height: 30px;
    width: auto;
  }

  /* ---- Navigation ---- */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--r-md);
    color: var(--c-header-fg-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 150ms ease, background-color 150ms ease;
    position: relative;
  }
  .nav-item:hover {
    color: var(--c-white);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-item.active {
    color: var(--c-white);
    background: var(--c-accent);
  }
  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }
  .nav-icon svg {
    width: 20px;
    height: 20px;
  }
  .nav-label {
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 200ms ease;
  }

  /* ---- Tooltip (only when collapsed) ---- */
  .nav-item::after {
    content: attr(data-label);
    position: absolute;
    left: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(-4px);
    padding: 0.35rem 0.6rem;
    background: var(--c-bg-dark);
    color: var(--c-white);
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: var(--r-sm);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease, transform 150ms ease;
    box-shadow: var(--c-shadow-medium);
    z-index: 50;
  }
  .admin-sidebar.collapsed .nav-item:hover::after,
  :global([data-amena-sidebar="collapsed"]) .admin-sidebar .nav-item:hover::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* ---- User info ---- */
  .sidebar-user {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem 0.5rem 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .user-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .user-email {
    color: var(--c-header-fg);
    font-size: 0.8rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .role-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: var(--c-white);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .user-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .logout-form {
    margin: 0;
  }
  .logout-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.4rem 0.6rem;
    background: transparent;
    color: var(--c-header-fg-muted);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-sm);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 500;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  .logout-btn:hover {
    color: var(--c-white);
    background: var(--c-danger);
    border-color: var(--c-danger);
  }
  .logout-label {
    line-height: 1;
  }

  /* ---- Toggle button ---- */
  .sidebar-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-left: auto;
    background: transparent;
    color: var(--c-header-fg-muted);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  .sidebar-toggle:hover {
    color: var(--c-white);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.35);
  }
  .chevron {
    transition: transform 300ms ease;
  }
  .admin-sidebar.collapsed .chevron {
    transform: rotate(180deg);
  }

  /* ---- Overlay ---- */
  .sidebar-overlay {
    position: fixed;
    inset: 0;
    z-index: 35;
    background: var(--c-overlay-mid);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  /* ---- Desktop ---- */
  @media (min-width: 861px) {
    .admin-sidebar {
      position: sticky;
      top: 0;
      height: 100dvh;
      transform: none;
      width: 240px;
      flex-shrink: 0;
    }
    .admin-sidebar.collapsed,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar {
      width: 64px;
    }
    .admin-sidebar.collapsed .sidebar-inner,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .sidebar-inner {
      padding-inline: 0.5rem;
      align-items: center;
    }
    .admin-sidebar.collapsed .brand-full,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .brand-full {
      display: none;
    }
    .admin-sidebar.collapsed .brand-icon,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .brand-icon {
      display: inline-flex;
    }
    .admin-sidebar.collapsed .nav-item,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .nav-item {
      justify-content: center;
      padding-inline: 0;
      width: 44px;
    }
    .admin-sidebar.collapsed .nav-label,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .nav-label {
      display: none;
    }
    .admin-sidebar.collapsed .user-meta,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .user-meta {
      display: none;
    }
    .admin-sidebar.collapsed .sidebar-user,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .sidebar-user {
      padding: 0.5rem 0;
      border-top: 0;
      align-items: center;
    }
    .admin-sidebar.collapsed .logout-btn,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .logout-btn {
      width: 32px;
      height: 32px;
      padding: 0;
      justify-content: center;
    }
    .admin-sidebar:not(.collapsed) .logout-btn {
      width: auto;
      height: 32px;
      padding: 0 0.75rem;
    }
    .admin-sidebar.collapsed .logout-label,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .logout-label {
      display: none;
    }
    .admin-sidebar.collapsed .logout-btn::after,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .logout-btn::after {
      content: "Salir";
      position: absolute;
      left: calc(100% + 12px);
      top: 50%;
      transform: translateY(-50%) translateX(-4px);
      padding: 0.35rem 0.6rem;
      background: var(--c-bg-dark);
      color: var(--c-white);
      font-size: 0.8rem;
      font-weight: 500;
      border-radius: var(--r-sm);
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 150ms ease, transform 150ms ease;
      box-shadow: var(--c-shadow-medium);
      z-index: 50;
    }
    .admin-sidebar.collapsed .logout-btn:hover::after,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .logout-btn:hover::after {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
    .logout-btn {
      position: relative;
    }
    .sidebar-toggle {
      display: inline-flex;
    }
    .admin-sidebar:not(.collapsed) .user-row {
      flex-direction: row;
      align-items: center;
      gap: 0.4rem;
    }
    .admin-sidebar:not(.collapsed) .logout-form {
      flex: 1;
    }
    .admin-sidebar.collapsed .user-row,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .user-row {
      align-items: center;
    }
    .admin-sidebar.collapsed .sidebar-toggle,
    :global([data-amena-sidebar="collapsed"]) .admin-sidebar .sidebar-toggle {
      margin: 0 auto;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 860px) {
    .admin-sidebar {
      width: 260px;
    }
    .admin-sidebar.open {
      transform: translateX(0);
    }
    .admin-sidebar.open ~ .sidebar-overlay {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  const sidebar = document.getElementById("admin-sidebar");
  const toggle = document.getElementById("sidebar-toggle");
  const overlay = document.getElementById("sidebar-overlay");

  const STORAGE_KEY = "amena-sidebar-collapsed";

  // The head <script> already set data-amena-sidebar + the CSS uses
  // :global([data-amena-sidebar="collapsed"]) so the sidebar renders in the
  // correct state on first paint. We only need to set the class now so the
  // toggle handler has a single source of truth going forward.
  if (document.documentElement.getAttribute("data-amena-sidebar") === "collapsed") {
    sidebar?.classList.add("collapsed");
  }

  // Sync aria attributes (no-op for layout, so safe to run anytime).
  if (window.innerWidth >= 861) {
    const collapsed = sidebar?.classList.contains("collapsed");
    toggle?.setAttribute("aria-expanded", String(!collapsed));
    toggle?.setAttribute("aria-label", collapsed ? "Expandir menú" : "Colapsar menú");
  }

  // Desktop toggle
  toggle?.addEventListener("click", () => {
    const isCollapsed = sidebar?.classList.toggle("collapsed");
    localStorage.setItem(STORAGE_KEY, String(isCollapsed));
    if (isCollapsed) {
      document.documentElement.setAttribute("data-amena-sidebar", "collapsed");
    } else {
      document.documentElement.removeAttribute("data-amena-sidebar");
    }
    toggle.setAttribute("aria-expanded", String(!isCollapsed));
    toggle.setAttribute("aria-label", isCollapsed ? "Expandir menú" : "Colapsar menú");
  });

  // Mobile: hamburger in header opens sidebar
  const mobileToggle = document.getElementById("mobile-menu-toggle");
  mobileToggle?.addEventListener("click", () => {
    sidebar?.classList.add("open");
  });

  overlay?.addEventListener("click", () => {
    sidebar?.classList.remove("open");
  });

  // Close mobile sidebar on nav click
  sidebar?.querySelectorAll(".nav-item").forEach((item) => {
    item.addEventListener("click", () => {
      if (window.innerWidth <= 860) {
        sidebar?.classList.remove("open");
      }
    });
  });
</script>
