---
import "@styles/global.css";
import type { User } from "@db/schema";
import Sidebar from "@shared/components/admin/Sidebar.astro";
import Header from "@shared/components/admin/Header.astro";

type Props = {
  title: string;
  user: User;
};

const { title, user } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Amena Inventario</title>
    <script is:inline>
      (function () {
        try {
          if (
            localStorage.getItem("amena-sidebar-collapsed") === "true" &&
            window.innerWidth >= 861
          ) {
            document.documentElement.setAttribute(
              "data-amena-sidebar",
              "collapsed"
            );
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <Sidebar />
      <div class="admin-main" id="admin-main">
        <Header title={title} user={user} />
        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  .admin-body {
    background: var(--c-bg);
    color: var(--c-text);
  }

  .admin-shell {
    display: flex;
    min-height: 100dvh;
  }

  .admin-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    transition: margin-left 300ms ease;
  }

  .admin-content {
    flex: 1;
    padding: 1.5rem;
    max-width: 100%;
  }

  /* Remove the old max-width constraint so views expand naturally */
  .admin-content :global(.page-header) {
    margin-bottom: 1.25rem;
  }

  @media (max-width: 860px) {
    .admin-content {
      padding: 1rem;
    }
  }
</style>
