---
import "@styles/global.css";
import type { User } from "@db/schema";
import Sidebar from "@shared/components/admin/Sidebar.astro";

type Props = {
  title: string;
  user: User;
};

const { title, user } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Amena Inventario</title>
    <script is:inline>
      (function () {
        try {
          if (
            localStorage.getItem("amena-sidebar-collapsed") === "true" &&
            window.innerWidth >= 861
          ) {
            document.documentElement.setAttribute(
              "data-amena-sidebar",
              "collapsed"
            );
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <Sidebar user={user} />
      <div class="admin-main" id="admin-main">
        <!-- Mobile: floating hamburger (replaces old top header) -->
        <button
          class="mobile-fab"
          id="mobile-menu-toggle"
          type="button"
          aria-label="Abrir menú"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" x2="20" y1="6" y2="6" />
            <line x1="4" x2="20" y1="12" y2="12" />
            <line x1="4" x2="20" y1="18" y2="18" />
          </svg>
        </button>
        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  .admin-body {
    background: var(--c-bg-dark);
    color: var(--c-text);
  }

  .admin-shell {
    display: flex;
    height: 100dvh;
    min-height: 100dvh;
    background: var(--c-bg-dark);
  }

  .admin-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    background: var(--c-bg-dark);
  }

  .admin-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
    padding: 1rem;
    max-width: 100%;
    background: var(--c-bg-dark);
  }

  .admin-content :global(.page-header h1) {
    color: var(--c-header-fg);
  }

  .admin-content :global(.page-header .subtitle) {
    color: var(--c-header-fg-muted);
  }

  .admin-content :global(.page-header .btn-secondary) {
    color: var(--c-header-fg);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .admin-content :global(.page-header .btn-secondary:hover) {
    color: var(--c-white);
    border-color: var(--c-accent);
    background: rgba(255, 255, 255, 0.08);
  }

  .admin-content :global(.page-header) {
    margin-bottom: 1rem;
  }

  .mobile-fab {
    display: none;
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 45;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--c-surface);
    color: var(--c-text);
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    cursor: pointer;
    box-shadow: var(--c-shadow-medium);
  }

  @media (min-width: 861px) {
    .admin-content {
      padding-left: 0;
    }
  }

  @media (max-width: 860px) {
    .mobile-fab {
      display: inline-flex;
    }
  }
</style>
