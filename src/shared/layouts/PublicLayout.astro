---
import "@styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = "Residencial Amena — Lotes residenciales con casa modelo en Comalapa, El Salvador. Conoce la disponibilidad en tiempo real.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#244858" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
